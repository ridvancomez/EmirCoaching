@* Kayıt ekleme/düzenleme penceresi: başlık, alanlar (ChildContent), Vazgeç + Kaydet.
   Doğrulama API'de; hatalı alanların Türkçe mesajı sağ altta görünür, pencere açık kalır. *@
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="_options">
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        <div class="form-grid">
            @ChildContent
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => VisibleChanged.InvokeAsync(false)">Vazgeç</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSave" Disabled="Saving">
            @(Saving ? "Kaydediliyor…" : "Kaydet")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.Medium;

    private DialogOptions _options = new();

    protected override void OnParametersSet() =>
        _options = new() { MaxWidth = MaxWidth, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
}
