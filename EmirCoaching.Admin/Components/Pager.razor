@* Sunucu tarafı sayfalama (PagedResult): sayfa numaraları + toplam kayıt *@
@if (TotalCount > 0)
{
    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mt-4">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Toplam @TotalCount kayıt</MudText>
        @if (TotalPages > 1)
        {
            <MudPagination Count="TotalPages" Selected="Page" SelectedChanged="PageChanged" Color="Color.Primary" Size="Size.Small" />
        }
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int TotalCount { get; set; }
}
