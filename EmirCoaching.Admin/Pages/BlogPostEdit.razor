@page "/blog-posts/new"
@page "/blog-posts/{Id:int}"
@inject IAdminBlogPostsClient Client
@inject IAdminBlogCategoriesClient CategoriesClient
@inject IAdminPackagesClient PackagesClient
@inject ApiCaller Api
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Yeni yazı" : _form.Title) | Emir Coaching Panel</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />
<PageHeader Title="@(IsNew ? "Yeni yazı" : "Yazıyı düzenle")"
            Description="@(IsNew ? "Taslak olarak kaydedilir. Yazar sensin." : _isPublished ? "Bu yazı yayında." : "Bu yazı taslak.")">
    <Actions>
        @if (!IsNew)
        {
            @if (_isPublished)
            {
                <MudButton Variant="Variant.Outlined" OnClick="() => SetPublishedAsync(false)" StartIcon="@Icons.Material.Outlined.Unpublished">Taslağa al</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SetPublishedAsync(true)" StartIcon="@Icons.Material.Outlined.Publish">Yayınla</MudButton>
            }
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">@(_saving ? "Kaydediliyor…" : "Kaydet")</MudButton>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" lg="8">
            <MudPaper Outlined="true" Class="pa-6">
                <div class="form-grid">
                    <MudTextField Value="_form.Title" ValueChanged="(string v) => OnTitleChanged(v)" Label="Başlık" Class="form-grid__full" Immediate="true" />
                    <MudTextField @bind-Value="_form.Slug" Label="Adres (slug)" HelperText="Addan otomatik üretilir" Class="form-grid__full" />
                    <MudTextField @bind-Value="_form.Summary" Label="Özet" Lines="3" Sizing="InputSizing.Auto" Class="form-grid__full"
                                  HelperText="Blog listesindeki kartta görünür" />
                </div>
                <div class="mt-4">
                    <HtmlEditor @ref="_editor" @bind-Value="_form.ContentHtml" Label="İçerik" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Outlined="true" Class="pa-6">
                <MudSelect @bind-Value="_form.CategoryId" Label="Kategori">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_form.ReadingMinutes" Label="Okuma süresi (dk)" Min="1" Class="mt-2" />
                <MudTextField @bind-Value="_tags" Label="Etiketler" HelperText="Virgülle ayır, ör. protein, kas gelişimi" Class="mt-2" />
                <MudSelect T="int?" @bind-Value="_form.RecommendedPackageId" Label="Önerilen paket" Clearable="true" Class="mt-2"
                           HelperText="Yazının altındaki öneri kartı">
                    @foreach (var package in _packages)
                    {
                        <MudSelectItem T="int?" Value="package.Id">@package.Name (@Labels.Of(package.Location))</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch @bind-Value="_form.IsFeatured" Label="Öne çıkan yazı" Color="Color.Primary" Class="mt-4" />
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-6 mt-4">
                <ImageUpload @bind-Value="_form.CoverImagePath" Label="Kapak görseli" Folder="blog" />
                <MudTextField @bind-Value="_form.CoverImageCaption" Label="Görsel açıklaması" Class="mt-2" HelperText="Görme engelliler için (alt metin)" />
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-6 mt-4">
                <MudText Typo="Typo.subtitle2">Arama motoru (SEO)</MudText>
                <MudTextField @bind-Value="_form.MetaTitle" Label="Sayfa başlığı" HelperText="Boşsa yazı başlığı kullanılır" Counter="70" />
                <MudTextField @bind-Value="_form.MetaDescription" Label="Açıklama" Lines="3" Sizing="InputSizing.Auto" Counter="160"
                              HelperText="Boşsa özet kullanılır" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private CreateBlogPostRequest _form = new() { ReadingMinutes = 5, Tags = [] };
    private string? _tags;
    private bool _isPublished;
    private bool _loaded;
    private bool _saving;
    private HtmlEditor? _editor;
    private List<BlogCategoryResponse> _categories = [];
    private List<PackageResponse> _packages = [];
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _categories = await Api.GetAsync(CategoriesClient.GetAllAsync) ?? [];
        _packages = await Api.GetAsync(PackagesClient.GetAllAsync) ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Id is { } id)
        {
            var post = await Api.GetAsync(() => Client.GetByIdAsync(id));
            if (post is null)
                return;
            _form = ObjectCopy.To<CreateBlogPostRequest>(post);
            _form.CoverImagePath = post.CoverImageUrl;
            _tags = string.Join(", ", post.Tags);
            _isPublished = post.IsPublished;
        }
        else
        {
            _form.CategoryId = _categories.FirstOrDefault()?.Id ?? 0;
        }

        _breadcrumbs = [new("Blog yazıları", "/blog-posts"), new(IsNew ? "Yeni yazı" : _form.Title, null, disabled: true)];
        _loaded = true;
    }

    private void OnTitleChanged(string title)
    {
        _form.Slug = SlugField.Follow(_form.Title, _form.Slug, title);
        _form.Title = title;
    }

    private async Task SaveAsync()
    {
        if (_editor is not null)
            _form.ContentHtml = await _editor.GetDataAsync();
        _form.Tags = (_tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        _saving = true;
        if (Id is { } id)
        {
            await Api.RunAsync(() => Client.UpdateAsync(id, ObjectCopy.To<UpdateBlogPostRequest>(_form)), "Kaydedildi.");
        }
        else
        {
            CreatedResponse? created = null;
            if (await Api.RunAsync(async () => created = await Client.CreateAsync(_form), "Taslak kaydedildi."))
                Navigation.NavigateTo($"/blog-posts/{created!.Id}");
        }
        _saving = false;
    }

    private async Task SetPublishedAsync(bool publish)
    {
        var id = Id!.Value;
        if (await Api.RunAsync(() => publish ? Client.PublishAsync(id) : Client.UnpublishAsync(id),
                publish ? "Yazı yayınlandı." : "Yazı taslağa alındı."))
            _isPublished = publish;
    }
}
