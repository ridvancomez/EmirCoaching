@page "/transformations"
@inject IAdminTransformationsClient Client
@inject ApiCaller Api
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>Değişimler | Emir Coaching Panel</PageTitle>

<PageHeader Title="Değişimler" Description="Danışanların önce/sonra hikâyeleri. “Ana sayfada” işaretliler ana sayfadaki kaydırmalı bölümde de çıkar.">
    <Actions>
        <MudButton Href="/transformations/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Yeni değişim</MudButton>
    </Actions>
</PageHeader>

<CrudTable TItem="TransformationResponse" Items="_items" Loading="_loading" @bind-SelectedItems="_selected"
           OnEdit="@(t => Navigation.NavigateTo($"/transformations/{t.Id}"))" OnDelete="ConfirmDeleteAsync" OnDeleteSelected="ConfirmDeleteSelectedAsync">
    <HeaderContent>
        <MudTh Style="width: 64px">Sıra</MudTh>
        <MudTh Style="width: 136px">Önce / sonra</MudTh>
        <MudTh>Danışan</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Bölüm</MudTh>
        <MudTh>Durum</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Sıra">@context.SortOrder</MudTd>
        <MudTd DataLabel="Görseller">
            <img src="@SiteLinks.Image(context.BeforeImageUrl)" alt="" class="table-thumb" />
            <img src="@SiteLinks.Image(context.AfterImageUrl)" alt="" class="table-thumb" />
        </MudTd>
        <MudTd DataLabel="Danışan">
            <MudLink Href="@($"/transformations/{context.Id}")">@context.ClientName</MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Age yaş · @context.DurationWeeks hafta · @context.Year</MudText>
        </MudTd>
        <MudTd DataLabel="Tip">@context.TransformationTypeName</MudTd>
        <MudTd DataLabel="Bölüm">@Labels.Of(context.Section)</MudTd>
        <MudTd DataLabel="Durum">
            <ActiveChip Active="context.IsActive" />
            @if (context.ShowOnHome)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Ana sayfada</MudChip>
            }
        </MudTd>
    </RowTemplate>
</CrudTable>

@code {
    private List<TransformationResponse> _items = [];
    private HashSet<TransformationResponse> _selected = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await Api.GetAsync(Client.GetAllAsync) ?? [];
        _selected = [];
        _loading = false;
    }

    private async Task ConfirmDeleteAsync(TransformationResponse item)
    {
        if (await Dialogs.ShowMessageBoxAsync("Onay", $"\"{item.ClientName}\" değişimi silinsin mi?", yesText: "Sil", cancelText: "Vazgeç") != true)
            return;
        if (await Api.RunAsync(() => Client.DeleteAsync(item.Id), "Silindi."))
            await LoadAsync();
    }

    private async Task ConfirmDeleteSelectedAsync()
    {
        var ids = _selected.Select(t => t.Id).ToList();
        if (await Dialogs.ShowMessageBoxAsync("Onay", $"Seçilen {ids.Count} değişim silinsin mi?", yesText: "Sil", cancelText: "Vazgeç") != true)
            return;
        if (await Api.RunAsync(() => Client.DeleteManyAsync(ids), $"{ids.Count} değişim silindi."))
            await LoadAsync();
    }
}
