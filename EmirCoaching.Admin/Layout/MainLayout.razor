@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

@* Giriş yapılmadan panel çizilmez: önce refresh cookie'siyle oturum geri alınmaya çalışılır *@
@if (!_ready)
{
    <div class="app-loading">Yükleniyor…</div>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="false">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="ToggleDrawer" aria-label="Menüyü aç/kapat" />
            <a href="/" class="admin-logo">
                <img src="images/logo.png" alt="Emir Coaching" width="162" height="24" />
            </a>
            <MudSpacer />
            <UserMenu />
        </MudAppBar>

        @* Responsive: geniş ekranda sabit açık, mobilde üstte açılıp kapanan çekmece *@
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="0">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.TryRestoreAsync())
        {
            _ready = true;
            return;
        }

        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo(returnUrl.Length > 0 ? $"/login?returnUrl={returnUrl}" : "/login");
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
