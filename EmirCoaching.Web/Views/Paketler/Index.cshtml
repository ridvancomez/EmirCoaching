@model PackagesViewModel
@{
    ViewData["Title"] = "Paketler | Emir Coaching — Sana Uygun Fitness ve Beslenme Paketi";
    ViewData["Description"] = "Emir Coaching fitness ve beslenme koçluğu paketlerini incele. evde ve salonda antrenman paketleri ile kişiye özel diyet planı seçenekleriyle hedefine uygun paketi seç, dönüşümünü başlat.";
    ViewData["ActiveNav"] = "paketler";
}

  <main>
    <!-- ==================== Paketler Hero ==================== -->
    <section class="paketler-hero" aria-labelledby="paketler-hero-title">
      <img src="@(Model.Hero?.BackgroundImageUrl ?? "/images/paketlerslider.png")" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Paketler" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/paketler" class="paketler-hero__breadcrumb-link" title="Paketler" aria-current="page">Paketler</a>
            </li>
          </ul>
        </nav>

        <h1 id="paketler-hero-title" class="paketler-hero__title">
          @SiteFormat.Highlight(Model.Hero?.Title, Model.Hero?.HighlightText, "paketler-hero__title-accent")
        </h1>

        <p class="paketler-hero__text">
          @Model.Hero?.Description
        </p>

        <nav class="paketler-hero__filter" aria-label="Paket filtresi">
          <div class="paketler-hero__tabs" role="tablist">
            <button type="button" class="paketler-hero__tab paketler-hero__tab--active" role="tab"
              aria-selected="true" data-tab="tumu" title="Tüm paketleri göster">Tümü</button>
            <button type="button" class="paketler-hero__tab paketler-hero__tab--evde" role="tab"
              aria-selected="false" data-tab="evde" title="Evde paketleri göster">Evde</button>
            <button type="button" class="paketler-hero__tab paketler-hero__tab--salonda" role="tab"
              aria-selected="false" data-tab="salonda" title="Salonda paketleri göster">Salonda</button>
          </div>
          <a href="/diyet-plani" class="paketler-hero__diet-btn" title="Kişiye özel diyet planı detaylarını incele">Kişiye
            Özel Diyet Planı</a>
        </nav>
      </div>
    </section>

    <!-- ==================== Paket Kartları (ana sayfadaki paket tasarımı) ====================
         Filtre (Tümü / Evde / Salonda) grupları gösterir/gizler; dar ekranda her grup ayrı carousel. -->
    <section class="paketler-cards paket-gruplari container" aria-label="Koçluk paketleri">
      @foreach (var group in Model.Groups)
      {
      <div class="paket-grup" data-category="@group.Key" role="group" aria-labelledby="@group.Key-grup-title">
        <h2 id="@group.Key-grup-title" class="paket-grup__title">@group.Title</h2>
        <div class="packages__slider" data-pkg-slider>
          <div class="packages__nav">
            <p class="packages__counter" aria-live="polite"><b data-pkg-current>1</b> / @group.Packages.Count</p>
            <div class="packages__arrows">
              <button type="button" class="round-arrow" data-pkg-prev title="Önceki @group.Label paket" aria-label="Önceki @group.Label paket">
                <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
              <button type="button" class="round-arrow" data-pkg-next title="Sonraki @group.Label paket" aria-label="Sonraki @group.Label paket">
                <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
            </div>
          </div>
          <div class="packages__track" data-pkg-track>
          @{ var perks = new PackagePerks(Model.Layout.Packages, group.Packages[0].Location); }
          @for (var i = 0; i < group.Packages.Count; i++)
          {
              var package = group.Packages[i];
              @await Html.PartialAsync("_PackageCard", new PackageCardModel(package, Math.Min(i + 1, 3), perks,
                  package.Slug, $"/paketler/{package.Slug}", Model.Layout.WhatsAppUrl))
          }
          </div>
          <div class="packages__dots" data-pkg-dots></div>
        </div>
      </div>
      }
    </section>

    <!-- ==================== Güvence şeridi (ana sayfadakiyle aynı) ==================== -->
    <section class="guvence container" aria-label="Ödeme ve iletişim güvenceleri">
      <div class="assurance">
        <ul class="assurance__list">
          <li class="assurance__item">
            <span class="assurance__icon"><iconify-icon icon="solar:shield-check-bold" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
            <span class="assurance__body"><strong class="assurance__title">Güvenli ödeme</strong><span class="assurance__text">Shopier altyapısı; kart bilgin bizde saklanmaz.</span></span>
          </li>
          <li class="assurance__item">
            <span class="assurance__icon"><iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
            <span class="assurance__body"><strong class="assurance__title">Birebir WhatsApp</strong><span class="assurance__text">Sorunu aracı olmadan doğrudan koçuna yazarsın.</span></span>
          </li>
          <li class="assurance__item">
            <span class="assurance__icon"><iconify-icon icon="solar:undo-left-round-bold" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
            <span class="assurance__body"><strong class="assurance__title">İade ve iptal koşulları</strong><span class="assurance__text">Satın almadan önce tamamını okuyabilirsin.</span></span>
          </li>
        </ul>
        <div class="assurance__legal">
          <a href="/yasal/mesafeli-satis" title="Mesafeli Satış Sözleşmesi">Mesafeli Satış Sözleşmesi</a>
          <a href="/yasal/iptal-iade" title="İade ve İptal Politikası">İade ve İptal Politikası</a>
        </div>
      </div>
    </section>

    <!-- ==================== Beslenme Programı ==================== -->
    <section id="beslenme-programi" class="beslenme" aria-labelledby="beslenme-title">
      <div class="container beslenme__inner">
        <header class="beslenme__header">
          <p class="beslenme__label">Beslenme Programı</p>
          <h2 id="beslenme-title" class="beslenme__title">
            HEDEFİNE UYGUN BESLEN, <span class="beslenme__title-accent">DÖNÜŞÜMÜ HIZLANDIR</span>
          </h2>
          <p class="beslenme__text">
            Yaşam tarzına, günlük rutinine ve hedeflerine uygun olarak hazırlanan sürdürülebilir beslenme
            programıyla gelişimini destekle.
          </p>
        </header>

        <div class="beslenme__box">
          <img src="/images/beslenme.jpg" alt="Spor salonunda hazırlanmış porsiyonlu sağlıklı yemek kutuları"
            title="Kişiye özel beslenme programı" width="512" height="286" class="beslenme__img">

          <div class="beslenme__content">
            <h3 class="beslenme__content-title">Kişiye Özel Beslenme Programı</h3>
            <ul class="beslenme__list">
              <li class="beslenme__item">Hedefe uygun kalori ve makro planlaması</li>
              <li class="beslenme__item">Kişiye özel günlük öğün düzeni</li>
              <li class="beslenme__item">Alternatif besin seçenekleri</li>
              <li class="beslenme__item">Haftalık gelişim değerlendirmesi</li>
              <li class="beslenme__item">Program süresince WhatsApp desteği</li>
            </ul>
            <p class="beslenme__note">Detaylı bilgi için iletişime geç</p>
            <a href="/diyet-plani" class="beslenme__button" title="Diyet programı hakkında daha fazla bilgi">Diyet programı hakkında daha fazla bilgi</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/card-filter.js"></script>
  <script src="/js/paket-slider.js"></script>
  <script src="/js/paketler.js"></script>
}
