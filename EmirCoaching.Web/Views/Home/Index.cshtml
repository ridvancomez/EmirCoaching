@model HomeViewModel
@{
    ViewData["Title"] = "Emir Coaching | Kişiye Özel Fitness ve Beslenme Koçluğu";
    ViewData["Description"] = "Emir Coaching ile hedefine özel antrenman ve beslenme planlarıyla dönüşümünü başlat. Profesyonel koçluk, WhatsApp üzerinden bizzat destek.";
    ViewData["ActiveNav"] = "anasayfa";
}

  <main>
    <section class="hero hero--home" aria-labelledby="hero-title">
      <div class="hero__media">
        <img src="@(Model.Hero?.BackgroundImageUrl ?? "/images/slider.png")" alt="Emir Coaching danışanlarının dönüşüm fotoğrafları"
          title="Emir Coaching danışan dönüşümleri" width="1440" height="897" class="hero__media-img">
      </div>

      <div class="container">
        <div class="hero__content">
          <h1 id="hero-title" class="hero__title">
            @SiteFormat.Highlight(Model.Hero?.Title, Model.Hero?.HighlightText, "hero__title-accent")
          </h1>

          <p class="hero__description">
            @Model.Hero?.Description
          </p>

          <div class="hero__actions">
            <a href="@(Model.Hero?.ButtonUrl ?? "/paketler")" class="hero__button hero__button--primary"
              title="Paketleri incele ve hemen başla">Hemen Başla</a>
            <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
              title="WhatsApp üzerinden bize ulaşın">
              <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              <span>WhatsApp İletişim</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="process" id="nasil-calisir" aria-labelledby="process-title">
      <div class="container">
        <div class="process__header">
          <div class="process__intro">
            <h2 id="process-title" class="home-title">Satın aldıktan sonra <span class="home-title__accent">NE OLUYOR?</span></h2>
            <p class="home-lead">Belirsizlik yok. Ödemeden programına kadar her adım belli, her adımda yanındayız.</p>
          </div>
          <a href="#paketler" class="home-outline-btn" title="Paketleri incele">Paketleri İncele</a>
        </div>
        <ol class="process__steps">
          @for (var i = 0; i < Model.PurchaseSteps.Count; i++)
          {
              var step = Model.PurchaseSteps[i];
          <li class="process__step" style="--step:@i">
            <div class="process__step-top">
              <span class="process__icon"><iconify-icon icon="@SiteFormat.PurchaseStepIcon(step.IconKey)" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="process__number" aria-hidden="true">@SiteFormat.StepNumber(i)</span>
            </div>
            <h3 class="process__step-title">@step.Title</h3>
            <p class="process__step-text">@step.Description</p>
            <span class="process__step-time">@step.TimeLabel</span>
          </li>
          }
        </ol>
      </div>
    </section>

    <section class="coach" aria-labelledby="coach-title">
      <div class="container coach__inner">
        @await Html.PartialAsync("_CoachMedia", Model.Coach)

        <div class="coach__content">
          <h2 id="coach-title" class="home-title">Bir salondan, <span class="home-title__accent">BİNLERCE</span> dönüşüme</h2>
          <div class="coach__story">
            @foreach (var paragraph in Model.Coach?.StoryParagraphs ?? [])
            {
            <p>@paragraph</p>
            }
          </div>
          @await Html.PartialAsync("_CertificateList", Model.Certificates)
          <a href="/hakkimda" class="coach__more" title="Hikayemin tamamını oku">
            <iconify-icon icon="ph:user-bold" mode="svg" noobserver aria-hidden="true" class="coach__more-icon"></iconify-icon>
            <span class="coach__more-body"><strong class="coach__cert-title">Hikayemin Tamamı</strong><span class="coach__cert-meta">Nasıl başladım, nasıl çalışıyorum</span></span>
            <iconify-icon icon="ph:arrow-right-bold" mode="svg" noobserver aria-hidden="true" class="coach__more-arrow"></iconify-icon>
          </a>
        </div>
      </div>
    </section>

    <section class="story" aria-labelledby="story-title">
      <div class="container">
        <div class="story__row">
          <div class="story__carousel-col">
            <div class="story__carousel">
              <div class="story__carousel-viewport">
                <div class="story__carousel-track">
                  @{ string[] slideStates = ["story__slide--active", "story__slide--stack-2", "story__slide--stack-3"]; }
                  @for (var i = 0; i < Model.Transformations.Count; i++)
                  {
                      var t = Model.Transformations[i];
                  <div class="story__slide @(i < slideStates.Length ? slideStates[i] : "story__slide--hidden")">
                    <div class="story__slide-wrapper">
                      <img src="@(t.AfterSquareUrl ?? t.AfterImageUrl)" alt="@t.ClientName, @t.TransformationTypeName dönüşümü" title="@t.ClientName — @t.TransformationTypeName" width="477" height="477" class="story__slide-img">
                    </div>
                    <button type="button" class="story__privacy-toggle" aria-pressed="false" title="Fotoğrafı göster / bulanıklaştır">
                      <span class="story__privacy-label">Fotoğrafı Göster</span>
                      <span class="story__privacy-switch" aria-hidden="true"><span class="story__privacy-knob"></span></span>
                    </button>
                  </div>
                  }
                </div>
              </div>
            </div>
            <div class="story__carousel-nav">
              <button type="button" class="story__carousel-arrow story__carousel-arrow--prev" title="Önceki slide'a geç">
                <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              </button>

              <div class="story__carousel-dots"></div>

              <button type="button" class="story__carousel-arrow story__carousel-arrow--next" title="Sonraki slide'a geç">
                <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              </button>
            </div>
          </div>

          <div class="story__content">
            <div class="story__badge">
              <iconify-icon icon="bi:award-fill" mode="svg" noobserver style="width:21px;height:28px;" aria-hidden="true"></iconify-icon>
              <span>Hikayemizi Bizden Dinleyin</span>
            </div>

            <h2 id="story-title" class="story__title">
              Motivasyon vermem.<br>
              <span class="story__title-accent">SİSTEM</span> kurarım.
            </h2>

            <p class="story__description">
              Motivasyon geçicidir, disiplin kalıcı. Vücudunu dönüştürecek sürdürülebilir ve bilimsel antrenman rutinini bugün inşa etmeye başla.
            </p>

            <div class="story__actions">
              <button type="button" class="story__btn story__btn--primary" title="Bilgi almak için iletişime geç" data-contact-trigger>Hemen Bilgi Al</button>
              <a href="/degisimler" class="story__btn story__btn--secondary" title="Tüm değişimleri gör">Bütün Değişimleri Gör</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="packages" id="paketler" aria-labelledby="packages-title">
      <div class="container">
        <div class="packages__header">
          <h2 id="packages-title" class="home-title">Sana uygun <span class="home-title__accent">PAKETİ</span> seç</h2>
          <p class="home-lead">Üç paketin içeriği aynı temele dayanır; fark süre ve birebir Zoom görüşmesinde.</p>
        </div>

        @{
            var homePackages = Model.Layout.MenuPackages.ToList();
            var homePerks = new PackagePerks(Model.Layout.Packages, PackageLocation.Salonda);
        }
        <div class="packages__slider" data-pkg-slider>
          <div class="packages__nav">
            <p class="packages__counter" aria-live="polite"><b data-pkg-current>1</b> / @homePackages.Count</p>
            <div class="packages__arrows">
              <button type="button" class="round-arrow" data-pkg-prev title="Önceki paket" aria-label="Önceki paket">
                <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
              <button type="button" class="round-arrow" data-pkg-next title="Sonraki paket" aria-label="Sonraki paket">
                <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
            </div>
          </div>
          <div class="packages__track" data-pkg-track>
          @for (var i = 0; i < homePackages.Count; i++)
          {
              @await Html.PartialAsync("_PackageCard", new PackageCardModel(homePackages[i], Math.Min(i + 1, 3), homePerks,
                  null, $"/paketler#{homePackages[i].Slug}", Model.Layout.WhatsAppUrl))
          }
          </div>
          <div class="packages__dots" data-pkg-dots></div>
        </div>

        <div class="reviews" data-reviews aria-roledescription="carousel" aria-label="Danışan yorumları">
          <button type="button" class="round-arrow reviews__arrow reviews__arrow--prev" data-reviews-prev title="Önceki yorum" aria-label="Önceki yorum">
            <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
          <div class="reviews__viewport">
            <div class="reviews__track" data-reviews-track>
              @for (var i = 0; i < Model.Testimonials.Count; i++)
              {
                  var review = Model.Testimonials[i];
              <figure class="reviews__item" aria-roledescription="slide" aria-label="@(i + 1) / @Model.Testimonials.Count">
                <iconify-icon icon="ri:double-quotes-l" mode="svg" noobserver aria-hidden="true" class="reviews__mark"></iconify-icon>
                <blockquote class="reviews__quote">@review.Text</blockquote>
                <figcaption class="reviews__author"><b>@review.Name</b> · @review.PackageName, @review.PackageDurationMonths ay</figcaption>
              </figure>
              }
            </div>
          </div>
          <button type="button" class="round-arrow reviews__arrow reviews__arrow--next" data-reviews-next title="Sonraki yorum" aria-label="Sonraki yorum">
            <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon></button>
          <div class="reviews__dots" data-reviews-dots></div>
        </div>

        <div class="assurance">
          <ul class="assurance__list">
            <li class="assurance__item">
              <span class="assurance__icon"><iconify-icon icon="solar:shield-check-bold" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="assurance__body"><strong class="assurance__title">Güvenli ödeme</strong><span class="assurance__text">Shopier altyapısı; kart bilgin bizde saklanmaz.</span></span>
            </li>
            <li class="assurance__item">
              <span class="assurance__icon"><iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="assurance__body"><strong class="assurance__title">Birebir WhatsApp</strong><span class="assurance__text">Sorunu aracı olmadan doğrudan koçuna yazarsın.</span></span>
            </li>
            <li class="assurance__item">
              <span class="assurance__icon"><iconify-icon icon="solar:undo-left-round-bold" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="assurance__body"><strong class="assurance__title">İade ve iptal koşulları</strong><span class="assurance__text">Satın almadan önce tamamını okuyabilirsin.</span></span>
            </li>
          </ul>
          <div class="assurance__legal">
            <a href="/yasal/mesafeli-satis" title="Mesafeli Satış Sözleşmesi">Mesafeli Satış Sözleşmesi</a>
            <a href="/yasal/iptal-iade" title="İade ve İptal Politikası">İade ve İptal Politikası</a>
          </div>
        </div>
      </div>
    </section>

    <section class="faq" aria-label="Sıkça Sorulan Sorular">
      <div class="container">
        <h2 class="faq__title">
          <span class="faq__title-line">SIKÇA</span>
          <span class="faq__title-line faq__title-line--accent">SORULAN</span>
          <span class="faq__title-line">SORULAR</span>
        </h2>

        <div class="faq__row">
          <div class="faq__intro">
            <p class="faq__desc">
              Sana en şeffaf şekilde bilgileri vermek istiyoruz. Aklına takılan bütün soruların cevabını buradan bulabilirsin.
            </p>

            <div class="faq__features">
              <div class="faq__feature">
                <iconify-icon icon="ph:barbell-bold" mode="svg" noobserver width="20" height="20" class="faq__feature-icon" aria-hidden="true"></iconify-icon>
                <div class="faq__feature-text">
                  <h3 class="faq__feature-title">Hedef Odaklı</h3>
                  <p class="faq__feature-desc">Kişisel hedeflerine göre özel planlama</p>
                </div>
              </div>

              <div class="faq__feature">
                <iconify-icon icon="bi:shield-fill-check" mode="svg" noobserver width="19" height="19" class="faq__feature-icon" aria-hidden="true"></iconify-icon>
                <div class="faq__feature-text">
                  <h3 class="faq__feature-title">Bilimsel &amp; Güvenilir</h3>
                  <p class="faq__feature-desc">Kanıta dayalı yöntemlerle sürdürülebilir sonuçlar</p>
                </div>
              </div>

              <div class="faq__feature">
                <iconify-icon icon="noto:left-speech-bubble" mode="svg" noobserver width="26" height="26" class="faq__feature-icon" aria-hidden="true"></iconify-icon>
                <div class="faq__feature-text">
                  <h3 class="faq__feature-title">Sürekli Destek</h3>
                  <p class="faq__feature-desc">Antrenman boyunca sürekli yanındayız</p>
                </div>
              </div>
            </div>
          </div>

          <div class="faq__accordion">
            @for (var i = 0; i < Model.Faqs.Count; i++)
            {
                var faq = Model.Faqs[i];
                var open = i == 0;
            <div class="faq__item@(open ? " faq__item--open" : "")">
              <button type="button" class="faq__item-header" aria-expanded="@(open ? "true" : "false")" aria-controls="faq-answer-@(i + 1)">
                <span class="faq__item-question">@faq.Question</span>
                <span class="faq__item-toggle" aria-hidden="true">
                  <iconify-icon icon="fa6-solid:@(open ? "minus" : "plus")" mode="svg" noobserver></iconify-icon>
                </span>
              </button>
              <div class="faq__item-body" id="faq-answer-@(i + 1)">
                <p class="faq__item-answer">
                  @faq.Answer
                </p>
              </div>
            </div>
            }
          </div>
        </div>
      </div>
    </section>
    <section class="social" aria-labelledby="social-title">
      <div class="container">
        <div class="social__card">
          <div class="social__intro">
            <div class="social__profile">
              <span class="social__avatar" aria-hidden="true"><span>E</span></span>
              <span class="social__handle"><strong>@@emircoaching</strong><span>Antrenman, beslenme ve danışan dönüşümleri</span></span>
            </div>
            <h2 id="social-title" class="social__title">Bizi takip et</h2>
            <p class="social__text">Her hafta yeni içerik: antrenman teknikleri, beslenme ipuçları ve gerçek dönüşümler.</p>
            <div class="social__buttons">
              <a href="@(Model.Layout.Link(SocialPlatform.YouTube) ?? "https://youtube.com/")" class="social__button social__button--youtube" title="YouTube kanalımızı ziyaret edin" target="_blank" rel="noopener">
                <iconify-icon icon="fa6-brands:youtube" mode="svg" noobserver aria-hidden="true"></iconify-icon><span>YouTube</span></a>
              <a href="@(Model.Layout.Link(SocialPlatform.Instagram) ?? "https://instagram.com/")" class="social__button social__button--instagram" title="Instagram hesabımızı ziyaret edin" target="_blank" rel="noopener">
                <iconify-icon icon="fa6-brands:instagram" mode="svg" noobserver aria-hidden="true"></iconify-icon><span>Instagram</span></a>
            </div>
          </div>
          <div class="social__previews">
            @foreach (var video in Model.YouTubePosts)
            {
            <a href="@video.Url" class="social__item social__item--youtube" title="@video.Title videosunu izle" target="_blank" rel="noopener">
              <img src="@video.ImageUrl" alt="Emir Coaching YouTube videosu: @video.Title" title="@video.Title"
                width="650" height="444" class="social__item-img" loading="lazy">
              <span class="social__badge social__badge--youtube"><iconify-icon icon="fa6-brands:youtube" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="social__play" aria-hidden="true"><iconify-icon icon="ph:play-fill" mode="svg" noobserver></iconify-icon></span>
              <span class="social__video-title">@video.Title</span>
            </a>
            }
            @foreach (var post in Model.InstagramPosts)
            {
          <a href="@post.Url" class="social__item" title="Instagram gönderisini aç" target="_blank" rel="noopener">
            <img src="@post.ImageUrl" alt="Emir Coaching Instagram gönderisi" title="Emir Coaching Instagram gönderisi"
              width="333" height="458" class="social__item-img" loading="lazy">
            <span class="social__badge"><iconify-icon icon="fa6-brands:instagram" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
            @if (post.LikeCount is { } likes)
            {
            <span class="social__likes"><iconify-icon icon="fa6-solid:heart" mode="svg" noobserver aria-hidden="true"></iconify-icon>@SiteFormat.Number(likes)</span>
            }
          </a>
            }
          </div>
        </div>
      </div>
    </section>
    <section class="cta cta--home" aria-labelledby="cta-title">
      <div class="cta__triangle" aria-hidden="true"></div>
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Modals {
  <div class="video-modal" id="video-modal" aria-hidden="true">
    <div class="video-modal__overlay" data-video-close></div>
    <div class="video-modal__box" role="dialog" aria-modal="true" aria-label="Tanıtım videosu">
      <button type="button" class="video-modal__close" title="Kapat" aria-label="Kapat" data-video-close>
        <iconify-icon icon="fa6-solid:xmark" mode="svg" noobserver aria-hidden="true"></iconify-icon>
      </button>
      <div class="video-modal__frame">
        <p class="video-modal__placeholder">Tanıtım videosu yakında eklenecek.</p>
      </div>
    </div>
  </div>
}

@section Scripts {
  <script src="/js/paket-slider.js"></script>
  <script src="/js/index.js"></script>
  <script src="/js/hakkimda.js"></script>
}
