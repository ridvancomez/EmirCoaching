@{
    ViewData["Title"] = "Emir Coaching | Kişiye Özel Fitness ve Beslenme Koçluğu";
    ViewData["Description"] = "Emir Coaching ile hedefine özel antrenman ve beslenme planlarıyla dönüşümünü başlat. Profesyonel koçluk, WhatsApp üzerinden bizzat destek.";
    ViewData["ActiveNav"] = "anasayfa";
}

  <main>
    <section class="hero hero--home" aria-labelledby="hero-title">
      <div class="hero__media">
        <img src="/images/slider.png" alt="Emir Coaching danışanlarının dönüşüm fotoğrafları"
          title="Emir Coaching danışan dönüşümleri" width="1440" height="897" class="hero__media-img">
      </div>

      <div class="container">
        <div class="hero__content">
          <h1 id="hero-title" class="hero__title">
            Kendini, bahanelerinden <br /> daha <span class="hero__title-accent">GÜÇLÜ</span> hale getir
          </h1>

          <p class="hero__description">
            Ya da ona benzer bir şey. Bedenin yoldaşları rahattır, ancak seçkin değildirler. Ve nibh, o alacalı olan,
            onun giriş bölümü, hayattır; böylece bir şey olabilir.
          </p>

          <div class="hero__actions">
            <a href="/paketler" class="hero__button hero__button--primary"
              title="Paketleri incele ve hemen başla">Hemen Başla</a>
            <a href="https://wa.me/" class="hero__button hero__button--secondary"
              title="WhatsApp üzerinden bize ulaşın">
              <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              <span>WhatsApp İletişim</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="process" id="nasil-calisir" aria-labelledby="process-title">
      <div class="container">
        <div class="process__header">
          <div class="process__intro">
            <h2 id="process-title" class="home-title">Satın aldıktan sonra <span class="home-title__accent">NE OLUYOR?</span></h2>
            <p class="home-lead">Belirsizlik yok. Ödemeden programına kadar her adım belli, her adımda yanındayız.</p>
          </div>
          <a href="#paketler" class="home-outline-btn" title="Paketleri incele">Paketleri İncele</a>
        </div>
        <ol class="process__steps">
          <li class="process__step" style="--step:0">
            <div class="process__step-top">
              <span class="process__icon"><iconify-icon icon="solar:clipboard-list-broken" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="process__number" aria-hidden="true">01</span>
            </div>
            <h3 class="process__step-title">Form + Kan Tahlili</h3>
            <p class="process__step-text">Ödemeden sonra koçun WhatsApp'tan danışan bilgi formunu ve tahlil rehberini gönderir. Formu doldurur, tahlillerini iletirsin.</p>
            <span class="process__step-time">Gün 1</span>
          </li>
          <li class="process__step" style="--step:1">
            <div class="process__step-top">
              <span class="process__icon"><iconify-icon icon="solar:clock-circle-broken" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="process__number" aria-hidden="true">02</span>
            </div>
            <h3 class="process__step-title">48 Saatte Program</h3>
            <p class="process__step-text">Tahlil sonuçların ve hedefine göre kişiye özel antrenman ve beslenme programın hazırlanır.</p>
            <span class="process__step-time">En geç 48 saat</span>
          </li>
          <li class="process__step" style="--step:2">
            <div class="process__step-top">
              <span class="process__icon"><iconify-icon icon="solar:calendar-broken" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="process__number" aria-hidden="true">03</span>
            </div>
            <h3 class="process__step-title">Haftalık Takip</h3>
            <p class="process__step-text">Haftalık form kontrolleri (tartı + fotoğraf) ve WhatsApp üzerinden birebir iletişim.</p>
            <span class="process__step-time">Her hafta</span>
          </li>
          <li class="process__step" style="--step:3">
            <div class="process__step-top">
              <span class="process__icon"><iconify-icon icon="solar:refresh-circle-broken" mode="svg" noobserver aria-hidden="true"></iconify-icon></span>
              <span class="process__number" aria-hidden="true">04</span>
            </div>
            <h3 class="process__step-title">Revize</h3>
            <p class="process__step-text">Gelişimine göre program anında güncellenir; plato evresine girmene izin verilmez.</p>
            <span class="process__step-time">İhtiyaç oldukça</span>
          </li>
        </ol>
      </div>
    </section>

