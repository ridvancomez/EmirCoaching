              class="compare__img compare__img--follow compare__img--after" loading="lazy" draggable="false">
            <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
              width="568" height="136" class="compare__logo" draggable="false">
            <span class="compare__label compare__label--before" aria-hidden="true">Önce</span>
            <span class="compare__label compare__label--after" aria-hidden="true">Sonra</span>
            <button type="button" class="compare__zoom" data-hikaye-open="mert"
              title="Mert'in değişim hikayesini büyüt" aria-label="Mert'in değişim hikayesini büyüt">
              <iconify-icon icon="mdi:arrow-expand" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            </button>
            <span class="compare__divider" aria-hidden="true">
              <span class="compare__handle">
                <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
              </span>
            </span>
            <label for="degisim-range-mert" class="visually-hidden">Mert: öncesi ve sonrası karşılaştırma</label>
            <input type="range" id="degisim-range-mert" class="compare__range" min="0" max="100" step="1" value="50">
          </figure>
          <div class="degisim-card__body">
            <h3 id="degisim-mert-title" class="degisim-card__name">Mert, 28</h3>
            <ul class="degisim-card__tags" aria-label="Program bilgisi">
              <li class="degisim-card__tag">12 Hafta</li>
              <li class="degisim-card__tag">Yağ Kaybı</li>
            </ul>
