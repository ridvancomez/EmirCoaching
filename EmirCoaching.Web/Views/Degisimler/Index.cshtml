@model TransformationsViewModel
@{
    ViewData["Title"] = "Değişimler | Emir Coaching — Gerçek Danışan Dönüşümleri";
    ViewData["Description"] = "Emir Coaching danışanlarının gerçek önce/sonra değişimleri. Yağ kaybı, kas kazanımı ve kondisyon hedeflerine ulaşan danışanlarımızın hikayelerini ve sonuçlarını inceleyin.";
    ViewData["ActiveNav"] = "degisimler";
}

  <main>
    <!-- ==================== Değişimler Hero + Stats ==================== -->
    <section class="paketler-hero paketler-hero--compact blog-hero degisim-hero" aria-labelledby="degisim-title">
      <img src="@(Model.Hero?.BackgroundImageUrl ?? "/images/paketlerslider.png")" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Değişimler" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/degisimler" class="paketler-hero__breadcrumb-link" title="Değişimler" aria-current="page">Değişimler</a>
            </li>
          </ul>
        </nav>

        <h1 id="degisim-title" class="paketler-hero__title degisim-hero__title">
          @SiteFormat.Highlight(Model.Hero?.Title, Model.Hero?.HighlightText, "paketler-hero__title-accent")
        </h1>
        <p class="degisim-hero__lead">
          @Model.Hero?.Description
        </p>
        <div class="cta__actions degisim-hero__actions">
          <a href="/paketler" class="hero__button hero__button--primary" title="Paketleri incele ve hemen başla">Hemen Başla</a>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>

      </div>
    </section>

    <!-- ==================== Tüm Değişimler (carousel) ==================== -->
    <section class="tum-degisimler container" aria-labelledby="tum-degisimler-title">
      <h2 id="tum-degisimler-title" class="tum-degisimler__title">Tüm Değişimler</h2>

      <!-- Kategori filtresi + sıralama (şimdilik kapalı). Açmak için: bu bloğu yorumdan çıkar,
           yukarıdaki <h2>'yi sil, section'a "detay" modifier class'ını ekle (alternatif-1'deki gibi) ve
           sayfa sonundaki card-filter.js ile degisimler-detay.js'i yorumdan çıkar.
      <div class="degisim-toolbar">
        <h2 id="tum-degisimler-title" class="degisim-toolbar__title">Tüm Değişimler</h2>
        <div class="degisim-filtre" role="group" aria-label="Kategoriye göre filtrele">
          <button type="button" class="degisim-filtre__pill degisim-filtre__pill--active" data-filter="tumu" aria-pressed="true"
            title="Tüm değişimleri göster">Tümü</button>
          <button type="button" class="degisim-filtre__pill" data-filter="yag-kaybi" aria-pressed="false"
            title="Yağ kaybı değişimlerini göster">Yağ Kaybı</button>
          <button type="button" class="degisim-filtre__pill" data-filter="kas-kazanimi" aria-pressed="false"
            title="Kas kazanımı değişimlerini göster">Kas Kazanımı</button>
          <button type="button" class="degisim-filtre__pill" data-filter="form-koruma" aria-pressed="false"
            title="Form koruma değişimlerini göster">Form Koruma</button>
        </div>
        <div class="degisim-toolbar__sort">
          <label for="degisim-sirala" class="visually-hidden">Sırala</label>
          <select id="degisim-sirala" class="degisim-toolbar__sort-select">
            <option value="en-yeniler" selected>En Yeniler</option>
            <option value="en-eskiler">En Eskiler</option>
          </select>
          <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="degisim-toolbar__sort-icon" aria-hidden="true"></iconify-icon>
        </div>
      </div>
      -->

      <div class="degisim-carousel" data-carousel data-filter-animate>
        <div class="degisim-carousel__viewport">
          <div class="degisim-carousel__track">
        @foreach (var t in Model.Carousel)
        {
            var key = $"{ContentToc.Slug(t.ClientName)}-{t.Id}";
        <article class="degisim-card" data-category="@t.TransformationTypeSlug" aria-labelledby="degisim-@key-title">
          <figure class="compare compare--kart@(t.AlignBottom ? " compare--alta-yasli" : "")" data-compare data-compare-tap="only-popup">
            <img src="@(t.BeforeSquareUrl ?? t.BeforeImageUrl)" alt="@t.ClientName adlı danışanın programdan önceki hali" title="@t.ClientName — öncesi" width="514" height="600"
              class="compare__img compare__img--follow" loading="lazy" draggable="false">
            <img src="@(t.AfterSquareUrl ?? t.AfterImageUrl)" alt="@t.ClientName adlı danışanın programdan sonraki hali" title="@t.ClientName — sonrası" width="604" height="600"
              class="compare__img compare__img--follow compare__img--after" loading="lazy" draggable="false">
            <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
              width="568" height="136" class="compare__logo" draggable="false">
            <span class="compare__label compare__label--before" aria-hidden="true">Önce</span>
            <span class="compare__label compare__label--after" aria-hidden="true">Sonra</span>
            <button type="button" class="compare__zoom" data-hikaye-open="@key"
              title="@t.ClientName'in değişim hikayesini büyüt" aria-label="@t.ClientName'in değişim hikayesini büyüt">
              <iconify-icon icon="mdi:arrow-expand" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            </button>
            <span class="compare__divider" aria-hidden="true">
              <span class="compare__handle">
                <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
              </span>
            </span>
            <label for="degisim-range-@key" class="visually-hidden">@t.ClientName: öncesi ve sonrası karşılaştırma</label>
            <input type="range" id="degisim-range-@key" class="compare__range" min="0" max="100" step="1" value="50">
          </figure>
          <div class="degisim-card__body">
            <h3 id="degisim-@key-title" class="degisim-card__name">@t.ClientName, @t.Age</h3>
            <ul class="degisim-card__tags" aria-label="Program bilgisi">
              <li class="degisim-card__tag">@t.DurationWeeks Hafta</li>
              <li class="degisim-card__tag">@t.TransformationTypeName</li>
            </ul>
            <blockquote class="degisim-card__quote">
              <p>"@t.Quote"</p>
            </blockquote>
            @await Html.PartialAsync("_TransformationMetrics", t.Metrics)
            <button type="button" class="degisim-card__link" data-hikaye-open="@key"
              title="@t.ClientName'in değişim hikayesini oku">
              Hikayeyi Oku
              <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            </button>
          </div>
          <template class="degisim-card__story">
            @foreach (var paragraph in SiteFormat.Paragraphs(t.Story))
            {
            <p>@paragraph</p>
            }
          </template>
        </article>
        }
          </div>
        </div>

        <div class="degisim-carousel__nav">
          <button type="button" class="degisim-carousel__arrow" data-carousel-prev aria-label="Önceki değişim" title="Önceki değişim">
            <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon>
          </button>
          <div class="degisim-carousel__dots" data-carousel-dots></div>
          <button type="button" class="degisim-carousel__arrow" data-carousel-next aria-label="Sonraki değişim" title="Sonraki değişim">
            <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon>
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== Önce/Sonra galerisi (2×2) ==================== -->
    @if (Model.Gallery.Count > 0)
    {
    <section class="degisim-galeri container" aria-label="Önce ve sonra galerisi">
      @for (var i = 0; i < Model.Gallery.Count; i++)
      {
          var t = Model.Gallery[i];
          var no = i + 1;
        <figure class="compare@(t.AlignBottom ? " compare--alta-yasli" : "")" data-compare data-compare-tap="only-popup">
            <img src="@(t.BeforeSquareUrl ?? t.BeforeImageUrl)" alt="@t.ClientName adlı danışanın programdan önceki hali" title="Danışan değişimi @no — öncesi" width="556" height="600"
              class="compare__img compare__img--follow" loading="lazy" draggable="false">
            <img src="@(t.AfterSquareUrl ?? t.AfterImageUrl)" alt="@t.ClientName adlı danışanın programdan sonraki hali" title="Danışan değişimi @no — sonrası" width="548" height="600"
              class="compare__img compare__img--follow compare__img--after" loading="lazy" draggable="false">
            <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
              width="568" height="136" class="compare__logo" draggable="false">
            <span class="compare__label compare__label--before" aria-hidden="true">Öncesi</span>
            <span class="compare__label compare__label--after" aria-hidden="true">Sonrası</span>
            <span class="compare__divider" aria-hidden="true">
              <span class="compare__handle">
                <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
              </span>
            </span>
            <label for="galeri-range-@no" class="visually-hidden">Danışan değişimi @no: öncesi ve sonrası karşılaştırma</label>
            <input type="range" id="galeri-range-@no" class="compare__range" min="0" max="100" step="1" value="50">
            <template class="degisim-galeri__hikaye">
              <h3 class="degisim-card__name">@t.ClientName, @t.Age</h3>
              <ul class="degisim-card__tags">
                <li class="degisim-card__tag">@t.DurationWeeks Hafta</li>
                <li class="degisim-card__tag">@t.TransformationTypeName</li>
              </ul>
              @await Html.PartialAsync("_TransformationMetrics", t.Metrics)
              <div class="degisim-card__story">
                @foreach (var paragraph in SiteFormat.Paragraphs(t.Story))
                {
                <p>@paragraph</p>
                }
              </div>
            </template>
          </figure>
      }
    </section>
    }

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Modals {
  <!-- Değişim hikayesi popup'ı (js/degisim-modal.js) -->
  <div class="degisim-modal" id="degisim-modal" aria-hidden="true">
    <div class="degisim-modal__overlay" data-degisim-close></div>
    <div class="degisim-modal__box" role="dialog" aria-modal="true" aria-labelledby="degisim-modal-title">
      <button type="button" class="degisim-modal__close" title="Kapat" aria-label="Kapat" data-degisim-close>
        <iconify-icon icon="fa6-solid:xmark" mode="svg" noobserver aria-hidden="true"></iconify-icon>
      </button>
      <div class="degisim-modal__scroll">
        <figure class="compare compare--modal" data-compare>
          <img src="/images/hakkimda-degisim-1-before-kare.jpg" alt="Danışanın programdan önceki hali" title="Öncesi" width="514"
            height="600" class="compare__img compare__img--follow" draggable="false">
          <img src="/images/hakkimda-degisim-1-after-kare.jpg" alt="Danışanın programdan sonraki hali" title="Sonrası" width="604"
            height="600" class="compare__img compare__img--follow compare__img--after" draggable="false">
          <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
            width="568" height="136" class="compare__logo" draggable="false">
          <span class="compare__label compare__label--before" aria-hidden="true">Öncesi</span>
          <span class="compare__label compare__label--after" aria-hidden="true">Sonrası</span>
          <span class="compare__divider" aria-hidden="true">
            <span class="compare__handle">
              <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
            </span>
          </span>
          <label for="degisim-modal-range" class="visually-hidden">Öncesi ve sonrası karşılaştırma</label>
          <input type="range" id="degisim-modal-range" class="compare__range" min="0" max="100" step="1" value="50">
        </figure>
        <div class="degisim-modal__body">
          <div class="degisim-modal__head">
            <h2 id="degisim-modal-title" class="degisim-modal__name">Değişim hikayesi</h2>
            <ul class="degisim-card__tags degisim-modal__tags" aria-label="Program bilgisi"></ul>
          </div>
          <div class="degisim-modal__story"></div>
          <dl class="degisim-card__metrics degisim-modal__metrics"></dl>
        </div>
      </div>
    </div>
  </div>
  <!-- Kategori filtresi + sıralama (şimdilik kapalı) -->
  <!-- -->
  <!-- -->
}

@section Scripts {
  <script src="/js/compare-slider.js"></script>
  <script src="/js/degisimler.js"></script>
  <script src="/js/degisim-modal.js"></script>
  <script src="/js/card-filter.js"></script>
  <script src="/js/degisimler-detay.js"></script>
}
