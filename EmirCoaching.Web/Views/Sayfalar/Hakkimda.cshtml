@{
    ViewData["Title"] = "Hakkımda | Emir Coaching — Bir Salondan Binlerce Dönüşüme";
    ViewData["Description"] = "Emir Coaching'in hikayesi: 8+ yıllık deneyim ve 100+ danışanla bilimsel temelli, sürdürülebilir fitness ve beslenme koçluğu.";
    ViewData["ActiveNav"] = "hakkimda";
}

  <main>
    <!-- ==================== Hero (iki kolon) ==================== -->
    <section class="paketler-hero paketler-hero--story" aria-labelledby="hikaye-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Hakkımda" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/hakkimda" class="paketler-hero__breadcrumb-link" title="Hakkımda" aria-current="page">Hakkımda</a>
            </li>
          </ul>
        </nav>

        <div class="container hikaye-hero">
          <div class="hikaye-hero__text">
            <h1 id="hikaye-title" class="hikaye-hero__title">
              BİR SALONDAN, <span class="hikaye-hero__title-accent">BİNLERCE</span> DÖNÜŞÜME
            </h1>
            <p class="hikaye-hero__lead">
              Gerçek değişim geçici motivasyonlarla değil, sürdürülebilir sistemlerle başlar. Emircoaching olarak,
              fiziksel potansiyelinizi ortaya çıkarmak için bilimsel temelli bir yaklaşım sunuyoruz.
            </p>
            <ul class="hikaye-hero__stats" aria-label="Emir Coaching rakamlarla">
              <li class="hikaye-hero__stat">8+ Yıl Deneyim</li>
              <li class="hikaye-hero__stat">100+ Danışan</li>
              <li class="hikaye-hero__stat">%95 Başarı</li>
            </ul>
            <div class="hikaye-hero__actions">
              <a href="/paketler" class="hero__button hero__button--primary"
                title="Paketleri incele ve hemen başla">Hemen Başla</a>
              <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
                title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
                <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
                <span>WhatsApp İletişim</span>
              </a>
            </div>
          </div>
          <img src="/images/hakkimda-hero.jpg" alt="Spor salonunda deadlift yapan kaslı sporcu"
            title="Emir Coaching — disiplin ve güç" width="593" height="644" class="hikaye-hero__img">
        </div>
      </div>
    </section>

    <!-- ==================== Perdenin Arkası: tanıtım videosu + sertifikalar ====================
         Ana sayfadaki koç bölümüyle aynı bileşen (coach__media, coach__certs) -->
    <section class="perde-arkasi coach coach--hakkimda container" aria-labelledby="perde-arkasi-title">
      <div class="coach__inner">
        <div class="coach__media">
          <img src="/images/hakkimda-video.png" alt="İbrahim Emir'in tanıtım videosundan bir kare" title="Emir Coaching tanıtım videosu"
            width="1238" height="664" class="coach__poster" loading="lazy">
          <button type="button" class="coach__play" title="Tanıtım videosunu oynat" aria-label="Tanıtım videosunu oynat"
            data-video-src="" data-video-open>
            <iconify-icon icon="ph:play-fill" mode="svg" noobserver aria-hidden="true"></iconify-icon>
          </button>
          <div class="coach__label">
            <img src="/images/yazar-ibrahim-emir-kucuk.jpg" alt="İbrahim Emir" title="İbrahim Emir" width="52" height="52"
              class="coach__avatar" loading="lazy">
            <span class="coach__label-text"><strong class="coach__name">İbrahim Emir</strong><span class="coach__role">Online Fitness &amp; Beslenme Koçu · 8+ yıl</span></span>
          </div>
        </div>

        <div class="coach__content">
          <h2 id="perde-arkasi-title" class="home-title">Eğitim ve <span class="home-title__accent">SERTİFİKALAR</span></h2>
          <ul class="coach__certs" aria-label="Sertifikalar">
            <li class="coach__cert">
              <span class="coach__cert-logo"><img src="/images/sertifika-tvgfbf.png" alt="Türkiye Vücut Geliştirme, Fitness ve Bilek Güreşi Federasyonu logosu" title="Türkiye Vücut Geliştirme, Fitness ve Bilek Güreşi Federasyonu" width="160" height="160" loading="lazy"></span>
              <span class="coach__cert-body"><strong class="coach__cert-title">2. Kademe Temel Antrenör Belgesi</strong><span class="coach__cert-meta">TVGFBF · 2021</span></span>
            </li>
            <li class="coach__cert">
              <span class="coach__cert-logo"><img src="/images/sertifika-fmi.png" alt="Fitness Movement Institute logosu" title="Fitness Movement Institute" width="160" height="160" loading="lazy"></span>
              <span class="coach__cert-body"><strong class="coach__cert-title">Nefes, Nörolojik Düzenleme ve Postür Eğitimi</strong><span class="coach__cert-meta">FMI · EREPS Seviye 4 · 2022</span></span>
            </li>
            <li class="coach__cert">
              <span class="coach__cert-logo"><img src="/images/sertifika-fmi.png" alt="Fitness Movement Institute logosu" title="Fitness Movement Institute" width="160" height="160" loading="lazy"></span>
              <span class="coach__cert-body"><strong class="coach__cert-title">Personal Trainer EQF Level 4</strong><span class="coach__cert-meta">FMI · 2023</span></span>
            </li>
            <li class="coach__cert">
              <span class="coach__cert-logo"><img src="/images/sertifika-biopeak.png" alt="Biopeak logosu" title="Biopeak" width="160" height="160" loading="lazy"></span>
              <span class="coach__cert-body"><strong class="coach__cert-title">Shoulder Performance Specialist</strong><span class="coach__cert-meta">Biopeak · 2024</span></span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ==================== Sayılar Yalan Söylemez ==================== -->
    <section class="sayilar container" aria-labelledby="sayilar-title">
      <div class="sayilar__header">
        <h2 id="sayilar-title" class="sayilar__title">Sayılar Yalan Söylemez</h2>
        <a href="/degisimler" class="sayilar__link" title="Tüm danışan sonuçlarını gör">
          <span>Tüm sonuçları gör</span>
          <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver aria-hidden="true"></iconify-icon>
        </a>
      </div>
      <!-- Önce/sonra karşılaştırma: üst katman (sonrası) slider değerine göre soldan kırpılır -->
      <div class="sayilar__grid">
        <figure class="compare" data-compare>
          <img src="/images/hakkimda-degisim-1-before-kare.jpg" alt="Erkek danışanın programdan önceki hali" title="Erkek danışan — öncesi" width="514" height="600"
            class="compare__img compare__img--follow" loading="lazy" draggable="false">
          <img src="/images/hakkimda-degisim-1-after-kare.jpg" alt="Erkek danışanın programdan sonraki kaslı hali" title="Erkek danışan — sonrası" width="604" height="600"
            class="compare__img compare__img--follow compare__img--after" loading="lazy" draggable="false">
          <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
            width="568" height="136" class="compare__logo" draggable="false">
          <span class="compare__label compare__label--before" aria-hidden="true">Öncesi</span>
          <span class="compare__label compare__label--after" aria-hidden="true">Sonrası</span>
          <span class="compare__divider" aria-hidden="true">
            <span class="compare__handle">
              <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
            </span>
          </span>
          <label for="compare-range-1" class="visually-hidden">Erkek danışan: öncesi ve sonrası karşılaştırma</label>
          <input type="range" id="compare-range-1" class="compare__range" min="0" max="100" step="1" value="50">
        </figure>

        <figure class="compare" data-compare>
          <img src="/images/hakkimda-degisim-2-before-kare.jpg" alt="Kadın danışanın programdan önceki hali" title="Kadın danışan — öncesi" width="556" height="600"
            class="compare__img compare__img--follow" loading="lazy" draggable="false">
          <img src="/images/hakkimda-degisim-2-after-kare.jpg" alt="Kadın danışanın programdan sonraki fit hali" title="Kadın danışan — sonrası" width="548" height="600"
            class="compare__img compare__img--follow compare__img--after" loading="lazy" draggable="false">
          <img src="/images/emircoaching-neon-logo.png" alt="EmirCoaching neon logosu" title="EmirCoaching"
            width="568" height="136" class="compare__logo" draggable="false">
          <span class="compare__label compare__label--before" aria-hidden="true">Öncesi</span>
          <span class="compare__label compare__label--after" aria-hidden="true">Sonrası</span>
          <span class="compare__divider" aria-hidden="true">
            <span class="compare__handle">
              <iconify-icon icon="mdi:swap-horizontal" mode="svg" noobserver></iconify-icon>
            </span>
          </span>
          <label for="compare-range-2" class="visually-hidden">Kadın danışan: öncesi ve sonrası karşılaştırma</label>
          <input type="range" id="compare-range-2" class="compare__range" min="0" max="100" step="1" value="50">
        </figure>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Modals {
  <div class="video-modal" id="video-modal" aria-hidden="true">
    <div class="video-modal__overlay" data-video-close></div>
    <div class="video-modal__box" role="dialog" aria-modal="true" aria-label="Tanıtım videosu">
      <button type="button" class="video-modal__close" title="Kapat" aria-label="Kapat" data-video-close>
        <iconify-icon icon="fa6-solid:xmark" mode="svg" noobserver aria-hidden="true"></iconify-icon>
      </button>
      <div class="video-modal__frame">
        <p class="video-modal__placeholder">Tanıtım videosu yakında eklenecek.</p>
      </div>
    </div>
  </div>
}

@section Scripts {
  <script src="/js/compare-slider.js"></script>
  <script src="/js/hakkimda.js"></script>
}
