@{
    ViewData["Title"] = "İletişim | Emir Coaching";
    ViewData["Description"] = "Emir Coaching ile iletişime geç: WhatsApp üzerinden hızlı destek ve program danışmanlığı al, Instagram, YouTube ve Facebook hesaplarımızı takip et.";
    ViewData["ActiveNav"] = "iletisim";
}

  <main>
    <!-- ==================== İletişim Hero ==================== -->
    <section class="paketler-hero paketler-hero--compact blog-hero degisim-hero iletisim-hero" aria-labelledby="iletisim-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching İletişim" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/iletisim" class="paketler-hero__breadcrumb-link" title="İletişim" aria-current="page">İletişim</a>
            </li>
          </ul>
        </nav>

        <h1 id="iletisim-title" class="paketler-hero__title degisim-hero__title iletisim-hero__title">
          Değişime İlk Adımı Atma <span class="paketler-hero__title-accent">Zamanı</span>
        </h1>
        <p class="degisim-hero__lead">
          Herkesin başlangıç noktası farklıdır. Önemli olan, hedefe giden yolda gösterilen kararlılık ve doğru
          stratejidir. İşte kanıtı.
        </p>
        <div class="cta__actions degisim-hero__actions">
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== Bize Ulaşın (sosyal kartlar) ==================== -->
    <section class="iletisim-sosyal container" aria-labelledby="iletisim-sosyal-title">
      <h2 id="iletisim-sosyal-title" class="iletisim-sosyal__title">Bize Ulaşın</h2>
      <div class="iletisim-sosyal__grid">
        <article class="sosyal-card sosyal-card--whatsapp" aria-labelledby="sosyal-whatsapp-title">
          <span class="sosyal-card__icon" aria-hidden="true">
            <iconify-icon icon="mdi:whatsapp" mode="svg" noobserver></iconify-icon>
          </span>
          <h3 id="sosyal-whatsapp-title" class="sosyal-card__title">WhatsApp</h3>
          <p class="sosyal-card__text">Hızlı destek ve program danışmanlığı için anında ulaş.</p>
          <a href="https://wa.me/905453712515" class="sosyal-card__button" title="WhatsApp üzerinden mesaj gönder"
            target="_blank" rel="noopener">Mesaj Gönder</a>
        </article>

        <article class="sosyal-card sosyal-card--instagram" aria-labelledby="sosyal-instagram-title">
          <span class="sosyal-card__icon" aria-hidden="true">
            <iconify-icon icon="mdi:instagram" mode="svg" noobserver></iconify-icon>
          </span>
          <h3 id="sosyal-instagram-title" class="sosyal-card__title">Instagram</h3>
          <p class="sosyal-card__text">Günlük motivasyon ve öğrenci değişimleri.</p>
          <a href="https://instagram.com/" class="sosyal-card__button" title="Instagram profilini incele" target="_blank" rel="noopener">Profili İncele</a>
        </article>

        <article class="sosyal-card sosyal-card--youtube" aria-labelledby="sosyal-youtube-title">
          <span class="sosyal-card__icon" aria-hidden="true">
            <iconify-icon icon="mdi:youtube" mode="svg" noobserver></iconify-icon>
          </span>
          <h3 id="sosyal-youtube-title" class="sosyal-card__title">YouTube</h3>
          <p class="sosyal-card__text">Antrenman teknikleri ve beslenme tüyoları.</p>
          <a href="https://youtube.com/" class="sosyal-card__button" title="YouTube kanalına git" target="_blank" rel="noopener">Kanala Git</a>
        </article>

        <article class="sosyal-card sosyal-card--facebook" aria-labelledby="sosyal-facebook-title">
          <span class="sosyal-card__icon" aria-hidden="true">
            <iconify-icon icon="mdi:facebook" mode="svg" noobserver></iconify-icon>
          </span>
          <h3 id="sosyal-facebook-title" class="sosyal-card__title">Facebook</h3>
          <p class="sosyal-card__text">Topluluğumuza katıl ve güncel duyuruları takip et.</p>
          <a href="https://facebook.com/" class="sosyal-card__button" title="Facebook sayfasını ziyaret et" target="_blank" rel="noopener">Sayfayı Ziyaret Et</a>
        </article>
      </div>
    </section>

    <!-- ==================== CTA (tek butonlu) ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
        </div>
      </div>
    </section>
  </main>
