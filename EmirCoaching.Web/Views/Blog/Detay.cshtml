@{
    ViewData["Title"] = "Kalori Açığı Nedir, Nasıl Doğru Hesaplanır? | Emir Coaching Blog";
    ViewData["Description"] = "Kalori açığı nedir, bazal metabolizma hızı (BMH) nasıl hesaplanır ve doğru açık miktarı ne olmalı? Emir Coaching ile sağlıklı ve sürdürülebilir kilo vermenin temelleri.";
    ViewData["ActiveNav"] = "blog";
}

  <main>
    <!-- ==================== Blog Detay Hero ==================== -->
    <section class="paketler-hero paketler-hero--compact blog-hero blog-detay-hero" aria-labelledby="blog-detay-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Blog" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/blog" class="paketler-hero__breadcrumb-link" title="Blog">Blog</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/blog?kategori=beslenme" class="paketler-hero__breadcrumb-link" title="Beslenme yazıları">Beslenme</a>
            </li>
          </ul>
        </nav>

        <div class="container blog-detay-hero__inner">
          <p class="blog-featured__category blog-detay-hero__category">Beslenme</p>
          <h1 id="blog-detay-title" class="blog-detay-hero__title">Kalori Açığı Nedir, Nasıl Doğru Hesaplanır?</h1>
          <p class="blog-detay-hero__lead">
            Kilo vermenin temel kuralı kalori açığı yaratmaktır. Ancak doğru hesaplanmayan bir kalori açığı
            metabolizmanızı yavaşlatabilir ve kas kaybına neden olabilir.
          </p>

          <ul class="blog-detay-hero__meta">
            <li class="blog-detay-hero__author">
              <img src="/images/yazar-ibrahim-emir-kucuk.jpg" alt="İbrahim Emir" title="İbrahim Emir"
                width="42" height="42" class="blog-detay-hero__avatar">
              <span class="blog-detay-hero__author-text">
                <strong class="blog-detay-hero__author-name">İbrahim Emir</strong>
                <span class="blog-detay-hero__author-role">Kurucu &amp; Baş Antrenör</span>
              </span>
            </li>
            <li class="blog-detay-hero__meta-item">
              <iconify-icon icon="mdi:calendar-blank-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              <time datetime="2024-10-24">24 Eki 2024</time>
            </li>
            <li class="blog-detay-hero__meta-item">
              <iconify-icon icon="mdi:clock-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              8 dk okuma
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ==================== Öne Çıkan Görsel ==================== -->
    <figure class="blog-detay-gorsel container">
      <div class="blog-detay-gorsel__frame">
        <img src="/images/blog-makro-besinler.jpg"
          alt="Peynir, domates, ekmek çubukları ve zeytinyağıyla hazırlanmış kahvaltı tabağı"
          title="Doğru hesaplanmış bir makro planı" width="1236" height="556" class="blog-detay-gorsel__img">
      </div>
      <figcaption class="blog-detay-gorsel__caption">Doğru hesaplanmış bir makro planı, başarının anahtarıdır.</figcaption>
    </figure>

    <!-- ==================== Gövde: makale + sticky sidebar ==================== -->
    <div class="blog-body blog-body--sticky-paket container">
      <!-- CKEditor içeriği bu <article> içine gelir.
           Tablo: editörün "Tablo ekle" butonu yeterli (<figure class="table"><table>…). İlk satır
           "başlık satırı" yapılırsa sütun adları dar ekranda kart etiketi olur. Sınıf, etiket ve
           ARIA rolleri js/blog-detay.js ile otomatik eklenir; "Tablo özellikleri" eklentisi
           (sabit genişlik/renk) kapalı olmalı. -->
      <article class="blog-body__content makale" aria-labelledby="blog-detay-title">
        <section id="giris" class="makale__section" aria-label="Giriş">
          <p>
            Fitness dünyasında en çok duyulan kavramlardan biri şüphesiz "kalori açığı"dır. İster yağ yakmak,
            ister kilo vermek isteyin, hedefinize ulaşmanın matematiksel temeli bu kavrama dayanır. Ancak mesele
            sadece "az yemek" değildir.
          </p>
          <p>
            Vücudunuz bir makine gibi çalışır ve bu makinenin çalışması için enerjiye (kaloriye) ihtiyacı vardır.
            Eğer bu makineye harcadığından daha az enerji verirseniz, aradaki farkı kapatmak için depoladığı
            enerjiyi (yağı) kullanmaya başlar. İşte bu sürece kalori açığı diyoruz.
          </p>
        </section>

        <section id="bazal-metabolizma-hizi" class="makale__section" aria-labelledby="bmh-title">
          <h2 id="bmh-title" class="makale__title">Bazal Metabolizma Hızı (BMH) Nedir?</h2>
          <p>
            Kalori açığı hesaplamaya başlamadan önce bilmeniz gereken ilk değer Bazal Metabolizma Hızınızdır (BMR).
            Bu, vücudunuzun tam dinlenme halindeyken (hiçbir şey yapmadan yattığınızda) hayatta kalmak için
            harcadığı enerjidir.
          </p>
          <!-- CKEditor: Alıntı bloğu + Stiller menüsünden "Formül Kutusu" (blockquote.makale-callout).
               İlk paragraf kutu başlığı, formül satırı Kod Bloğu (<pre><code>). İkon ve renkler CSS'ten
               gelir. Şu an elle yazılmış; editör çıktısına uyarlama backend aşamasında yapılacak. -->
          <div class="makale-callout">
            <p class="makale-callout__title">
              <iconify-icon icon="mdi:calculator-variant-outline" mode="svg" noobserver class="makale-callout__icon" aria-hidden="true"></iconify-icon>
              Mifflin-St Jeor Formülü (Erkekler için)
            </p>
            <pre class="makale-callout__formula"><code>BMH&nbsp;=&nbsp;(10&nbsp;×&nbsp;Ağırlık) +&nbsp;(6.25&nbsp;×&nbsp;Boy) −&nbsp;(5&nbsp;×&nbsp;Yaş)&nbsp;+&nbsp;5</code></pre>
          </div>
        </section>

        <section id="dogru-acik-miktari" class="makale__section" aria-labelledby="acik-title">
          <h2 id="acik-title" class="makale__title">Doğru Açık Miktarı Ne Olmalı?</h2>
          <p>
            En sık yapılan hata, sonucu hızlandırmak için aşırı büyük bir kalori açığı yaratmaktır. Bu durum kas
            kaybına, enerji düşüklüğüne ve metabolizmanın yavaşlamasına neden olur.
          </p>
          <ul class="makale__list">
            <li><strong>Hafif Açık (250-300 kcal):</strong> Yavaş ama çok sürdürülebilir. Maksimum kas koruması sağlar.</li>
            <li><strong>Orta Açık (500 kcal):</strong> Haftada yaklaşık 0.5 kg yağ kaybı sağlar. Çoğu kişi için idealdir.</li>
            <li><strong>Yüksek Açık (750+ kcal):</strong> Sadece ciddi obezite durumlarında ve uzman kontrolünde uygulanmalıdır.</li>
          </ul>
          <!-- CKEditor: Alıntı bloğu, stil seçilmeden (düz <blockquote>). -->
          <blockquote class="makale__quote">
            <p>"Hızlı kayıp, kalıcı kayıp değildir. Hedefiniz maraton koşmak olmalı, depar atmak değil."</p>
          </blockquote>
        </section>

        <section id="nasil-takip-edecegiz" class="makale__section" aria-labelledby="takip-title">
          <h2 id="takip-title" class="makale__title">Nasıl Takip Edeceğiz?</h2>
          <p>
            Hesaplamayı yaptıktan sonra süreci yönetmek işin pratik kısmıdır. Şunlara dikkat etmelisiniz:
          </p>
          <ol class="makale__list makale__list--ordered">
            <li>Mutfağınıza hassas bir dijital tartı alın. Göz kararı porsiyonlar genellikle yanıltıcıdır.</li>
            <li>Güvenilir bir kalori takip uygulaması indirin ve her öğünü kaydedin.</li>
            <li>Sıvı kalorileri (meyve suları, şekerli kahveler) gözden kaçırmayın.</li>
            <li>Haftalık tartılın ve ölçü alın; günlük dalgalanmalara takılmayın.</li>
          </ol>
          <!-- CKEditor: Alıntı bloğu + Stiller menüsünden "Dikkat Kutusu"
               (blockquote.makale-callout.makale-callout--dikkat). İlk paragraf başlık ("Dikkat"), altı metin. -->
          <div class="makale-callout makale-callout--dikkat" role="note">
            <p class="makale-callout__title">
              <iconify-icon icon="mdi:alert-outline" mode="svg" noobserver class="makale-callout__icon" aria-hidden="true"></iconify-icon>
              Dikkat
            </p>
            <p class="makale-callout__text">
              Kadınlar 1200 kcal, erkekler 1500 kcal altına kesinlikle inmemelidir. Bu değerlerin altı, mikro besin
              eksikliklerine ve hormonal bozukluklara yol açar.
            </p>
          </div>
        </section>

        <ul class="makale__tags" aria-label="Etiketler">
          <li class="makale__tag">#beslenme</li>
          <li class="makale__tag">#kilo-verme</li>
          <li class="makale__tag">#makro</li>
          <li class="makale__tag">#kalori-acigi</li>
        </ul>

        <section class="yazar-bio" aria-labelledby="yazar-bio-name">
          <img src="/images/yazar-ibrahim-emir.jpg" alt="İbrahim Emir" title="İbrahim Emir"
            width="95" height="95" class="yazar-bio__avatar">
          <div class="yazar-bio__body">
            <h2 id="yazar-bio-name" class="yazar-bio__name">İbrahim Emir</h2>
            <p class="yazar-bio__text">
              10 yılı aşkın tecrübesiyle yüzlerce kişinin fiziksel ve mental dönüşümüne rehberlik etmiş, bilimsel
              temelli antrenman ve beslenme prensiplerini savunan baş antrenör.
            </p>
            <a href="https://wa.me/905453712515" class="yazar-bio__button" title="İbrahim Emir'e WhatsApp üzerinden soru sor"
              target="_blank" rel="noopener">
              <iconify-icon icon="mdi:message-text-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              Soru Sor
            </a>
          </div>
        </section>
      </article>

      <aside class="blog-body__sidebar" aria-label="Yazı içeriği ve önerilen paket">
        <nav class="icindekiler" aria-labelledby="icindekiler-title">
          <button type="button" class="icindekiler__toggle" aria-expanded="true" aria-controls="icindekiler-list">
            <iconify-icon icon="mdi:format-list-bulleted" mode="svg" noobserver class="icindekiler__icon" aria-hidden="true"></iconify-icon>
            <span id="icindekiler-title">İçindekiler</span>
            <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="icindekiler__chevron" aria-hidden="true"></iconify-icon>
          </button>
          <ul id="icindekiler-list" class="icindekiler__list">
              <li class="icindekiler__item">
                <a href="#giris" class="icindekiler__link" title="Giriş bölümüne git">Giriş</a>
              </li>
              <li class="icindekiler__item">
                <a href="#bazal-metabolizma-hizi" class="icindekiler__link" title="Bazal Metabolizma Hızı (BMH) bölümüne git">Bazal Metabolizma Hızı (BMH)</a>
              </li>
              <li class="icindekiler__item">
                <a href="#dogru-acik-miktari" class="icindekiler__link" title="Doğru Açık Miktarı bölümüne git">Doğru Açık Miktarı</a>
              </li>
              <li class="icindekiler__item">
                <a href="#nasil-takip-edecegiz" class="icindekiler__link" title="Nasıl Takip Edeceğiz? bölümüne git">Nasıl Takip Edeceğiz?</a>
              </li>
          </ul>
        </nav>

        <section class="oneri-card" aria-labelledby="oneri-card-title">
          <p class="oneri-card__badge">Önerilen</p>
          <h2 id="oneri-card-title" class="oneri-card__title">Dönüşüm Protokolü</h2>
          <p class="oneri-card__text">Kişiye özel beslenme, antrenman ve 7/24 whatsapp desteği.</p>
          <p class="oneri-card__price">₺ 15.999 <span class="oneri-card__period">/ay</span></p>
          <a href="https://www.shopier.com/" class="hero__button hero__button--secondary oneri-card__button"
            title="Dönüşüm Protokolü paketini Shopier üzerinden satın alın" target="_blank" rel="noopener">
            <span>Satın Al</span>
          </a>
        </section>
      </aside>
    </div>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/blog-detay.js"></script>
}
