@model BlogDetailViewModel
@{
    var post = Model.Post;
    ViewData["Title"] = post.MetaTitle ?? $"{post.Title} | Emir Coaching Blog";
    ViewData["Description"] = post.MetaDescription ?? post.Summary;
    ViewData["ActiveNav"] = "blog";
}

  <main>
    <!-- ==================== Blog Detay Hero ==================== -->
    <section class="paketler-hero paketler-hero--compact blog-hero blog-detay-hero" aria-labelledby="blog-detay-title">
      <img src="@(Model.HeroImageUrl ?? "/images/paketlerslider.png")" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Blog" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/blog" class="paketler-hero__breadcrumb-link" title="Blog">Blog</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/blog?kategori=@post.CategorySlug" class="paketler-hero__breadcrumb-link" title="@post.CategoryName yazıları">@post.CategoryName</a>
            </li>
          </ul>
        </nav>

        <div class="container blog-detay-hero__inner">
          <p class="blog-featured__category blog-detay-hero__category">@post.CategoryName</p>
          <h1 id="blog-detay-title" class="blog-detay-hero__title">@post.Title</h1>
          <p class="blog-detay-hero__lead">
            @post.Summary
          </p>

          <ul class="blog-detay-hero__meta">
            @if (post.Author is { } author)
            {
            <li class="blog-detay-hero__author">
              <img src="@(author.AvatarUrl ?? "/images/yazar-ibrahim-emir-kucuk.jpg")" alt="@author.FullName" title="@author.FullName"
                width="42" height="42" class="blog-detay-hero__avatar">
              <span class="blog-detay-hero__author-text">
                <strong class="blog-detay-hero__author-name">@author.FullName</strong>
                @if (!string.IsNullOrWhiteSpace(author.Title))
                {
                <span class="blog-detay-hero__author-role">@author.Title</span>
                }
              </span>
            </li>
            }
            @if (post.PublishedAt is { } published)
            {
            <li class="blog-detay-hero__meta-item">
              <iconify-icon icon="mdi:calendar-blank-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              <time datetime="@published.ToString("yyyy-MM-dd")">@SiteFormat.ShortDate(published)</time>
            </li>
            }
            <li class="blog-detay-hero__meta-item">
              <iconify-icon icon="mdi:clock-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              @post.ReadingMinutes dk okuma
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ==================== Öne Çıkan Görsel ==================== -->
    @if (post.CoverImageUrl is { } cover)
    {
    <figure class="blog-detay-gorsel container">
      <div class="blog-detay-gorsel__frame">
        <img src="@cover"
          alt="@(post.CoverImageCaption ?? post.Title)"
          title="@(post.CoverImageCaption ?? post.Title)" width="1236" height="556" class="blog-detay-gorsel__img">
      </div>
      @if (!string.IsNullOrWhiteSpace(post.CoverImageCaption))
      {
      <figcaption class="blog-detay-gorsel__caption">@post.CoverImageCaption</figcaption>
      }
    </figure>
    }

    <!-- ==================== Gövde: makale + sticky sidebar ==================== -->
    <div class="blog-body blog-body--sticky-paket container">
      <!-- CKEditor içeriği bu <article> içine gelir.
           Tablo: editörün "Tablo ekle" butonu yeterli (<figure class="table"><table>…). İlk satır
           "başlık satırı" yapılırsa sütun adları dar ekranda kart etiketi olur. Sınıf, etiket ve
           ARIA rolleri js/blog-detay.js ile otomatik eklenir; "Tablo özellikleri" eklentisi
           (sabit genişlik/renk) kapalı olmalı. -->
      <article class="blog-body__content makale" aria-labelledby="blog-detay-title">
        @Html.Raw(Model.Content.Html)

        @if (post.Tags.Count > 0)
        {
        <ul class="makale__tags" aria-label="Etiketler">
          @foreach (var tag in post.Tags)
          {
          <li class="makale__tag">#@tag</li>
          }
        </ul>
        }

        @if (post.Author is { } bioAuthor)
        {
        <section class="yazar-bio" aria-labelledby="yazar-bio-name">
          <img src="@(bioAuthor.AvatarUrl ?? "/images/yazar-ibrahim-emir.jpg")" alt="@bioAuthor.FullName" title="@bioAuthor.FullName"
            width="95" height="95" class="yazar-bio__avatar">
          <div class="yazar-bio__body">
            <h2 id="yazar-bio-name" class="yazar-bio__name">@bioAuthor.FullName</h2>
            @if (!string.IsNullOrWhiteSpace(bioAuthor.Bio))
            {
            <p class="yazar-bio__text">
              @bioAuthor.Bio
            </p>
            }
            <a href="@(await Api.GetWhatsAppUrlAsync())" class="yazar-bio__button" title="@bioAuthor.FullName'e WhatsApp üzerinden soru sor"
              target="_blank" rel="noopener">
              <iconify-icon icon="mdi:message-text-outline" mode="svg" noobserver aria-hidden="true"></iconify-icon>
              Soru Sor
            </a>
          </div>
        </section>
        }
      </article>

      <aside class="blog-body__sidebar" aria-label="Yazı içeriği ve önerilen paket">
        @if (Model.Content.Entries.Count > 0)
        {
        <nav class="icindekiler" aria-labelledby="icindekiler-title">
          <button type="button" class="icindekiler__toggle" aria-expanded="true" aria-controls="icindekiler-list">
            <iconify-icon icon="mdi:format-list-bulleted" mode="svg" noobserver class="icindekiler__icon" aria-hidden="true"></iconify-icon>
            <span id="icindekiler-title">İçindekiler</span>
            <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="icindekiler__chevron" aria-hidden="true"></iconify-icon>
          </button>
          <ul id="icindekiler-list" class="icindekiler__list">
            @foreach (var entry in Model.Content.Entries)
            {
              <li class="icindekiler__item">
                <a href="#@entry.Id" class="icindekiler__link" title="@entry.Text bölümüne git">@entry.Text</a>
              </li>
            }
          </ul>
        </nav>
        }

        @if (post.RecommendedPackage is { } recommended)
        {
        <section class="oneri-card" aria-labelledby="oneri-card-title">
          <p class="oneri-card__badge">Önerilen</p>
          <h2 id="oneri-card-title" class="oneri-card__title">@recommended.Name</h2>
          <p class="oneri-card__text">@recommended.Subtitle</p>
          <p class="oneri-card__price">@SiteFormat.Price(recommended.MonthlyPrice).Replace("₺", "₺ ") <span class="oneri-card__period">/ay</span></p>
          <a href="@recommended.PurchaseUrl" class="hero__button hero__button--secondary oneri-card__button"
            title="@recommended.Name paketini Shopier üzerinden satın alın" target="_blank" rel="noopener">
            <span>Satın Al</span>
          </a>
        </section>
        }
      </aside>
    </div>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/blog-detay.js"></script>
}
