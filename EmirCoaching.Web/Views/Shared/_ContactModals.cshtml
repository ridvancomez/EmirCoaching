@{
    var layout = await Api.GetLayoutAsync();
}
  <div class="contact-modal" id="contact-modal" aria-hidden="true">
    <div class="contact-modal__overlay" data-contact-close></div>
    <div class="contact-modal__box" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
      <h3 id="contact-modal-title" class="contact-modal__title">BİZE YAZIN</h3>

      <form class="contact-modal__form" id="contact-form">
        <div class="contact-modal__row">
          <div class="contact-modal__field">
            <label for="contact-name" class="contact-modal__label">AD SOYAD</label>
            <input type="text" id="contact-name" name="name" class="contact-modal__input" placeholder="Ad - Soyad" required>
          </div>
          <div class="contact-modal__field">
            <label for="contact-phone" class="contact-modal__label">TELEFON</label>
            <input type="tel" id="contact-phone" name="phone" class="contact-modal__input" placeholder="05xx xxx xx xx" required>
          </div>
        </div>

        <div class="contact-modal__field">
          <label for="contact-email" class="contact-modal__label">E-POSTA</label>
          <input type="email" id="contact-email" name="email" class="contact-modal__input" placeholder="ornek@@eposta.com" required>
        </div>

        <div class="contact-modal__row">
          <div class="contact-modal__field">
            <label for="contact-package" class="contact-modal__label">İLGİLENDİĞİN PAKET</label>
            <div class="contact-modal__select-wrap">
              <select id="contact-package" name="package" class="contact-modal__select" required>
                <option value="" disabled selected>Seçiniz</option>
                @foreach (var p in layout.MenuPackages)
                {
                <option value="@p.Id">@p.Name</option>
                }
              </select>
              <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="contact-modal__select-icon" aria-hidden="true"></iconify-icon>
            </div>
          </div>
          <div class="contact-modal__field">
            <label for="contact-location" class="contact-modal__label">ANTRENMAN YERİ</label>
            <div class="contact-modal__select-wrap">
              <select id="contact-location" name="location" class="contact-modal__select" required>
                <option value="" disabled selected>Seçiniz</option>
                <option value="evde">Evde</option>
                <option value="salonda">Salonda</option>
              </select>
              <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="contact-modal__select-icon" aria-hidden="true"></iconify-icon>
            </div>
          </div>
        </div>

        <div class="contact-modal__field">
          <label for="contact-message" class="contact-modal__label">MESAJIN</label>
          <textarea id="contact-message" name="message" class="contact-modal__textarea" placeholder="Size nasıl yardımcı olabiliriz?"></textarea>
        </div>

        <div class="contact-modal__consent">
          <input type="checkbox" id="contact-consent" class="contact-modal__checkbox" required>
          <label for="contact-consent" class="contact-modal__consent-label">
            <a href="/gizlilik-politikasi" class="contact-modal__privacy-link" title="Gizlilik Politikasını görüntüle" target="_blank" rel="noopener">Gizlilik Politikası'nı</a> okudum ve kabul ediyorum.
          </label>
        </div>

        <button type="submit" class="contact-modal__submit">MESAJI GÖNDER</button>

        <p class="contact-modal__whatsapp-note">
          Formu doldurmak yerine <a href="@(await Api.GetWhatsAppUrlAsync())" class="contact-modal__whatsapp-link" title="WhatsApp'tan yaz">WhatsApp'tan yazmak</a> daha hızlı.
        </p>
      </form>
    </div>
  </div>

  <div class="contact-success-modal" id="contact-success-modal" aria-hidden="true">
    <div class="contact-success-modal__overlay" data-contact-success-close></div>
    <div class="contact-success-modal__box" role="dialog" aria-modal="true" aria-labelledby="contact-success-title">
      <button type="button" class="contact-success-modal__close" title="Kapat" aria-label="Kapat" data-contact-success-close>
        <iconify-icon icon="fa6-solid:xmark" mode="svg" noobserver aria-hidden="true"></iconify-icon>
      </button>
      <div class="contact-success-modal__icon">
        <iconify-icon icon="ph:check-bold" mode="svg" noobserver aria-hidden="true"></iconify-icon>
      </div>
      <h3 id="contact-success-title" class="contact-success-modal__title">Mesajınız İletildi!</h3>
      <p class="contact-success-modal__text">En kısa sürede size dönüş yapılacaktır.</p>
    </div>
  </div>
