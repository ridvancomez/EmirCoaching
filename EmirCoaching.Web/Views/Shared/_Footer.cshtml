@{
    var layout = await Api.GetLayoutAsync();
}
  <footer class="footer">
    <img src="/images/footer-e.png" alt="Emir Coaching dekoratif E harfi" title="Emir Coaching" width="752" height="394" class="footer__deco" aria-hidden="true">

    <div class="footer__container">
      <div class="footer__top">
        <img src="/images/footer-logo.png" alt="Emir Coaching Logo" title="Emir Coaching" width="434" height="64" class="footer__logo">
      </div>

      <div class="footer__columns">
        <div class="footer__col footer__col--links">
          <h3 class="footer__col-title">Bizi Tanıyın</h3>
          <ul class="footer__links">
            <li><a href="/" title="Ana Sayfa">Ana Sayfa</a></li>
            <li><a href="/hakkimda" title="Hakkımda">Hakkımda</a></li>
            <li><a href="/paketler" title="Paketler">Paketler</a></li>
            <li><a href="/blog" title="Blog">Blog</a></li>
            <li><a href="/iletisim" title="İletişim">İletişim</a></li>
          </ul>
        </div>

        <div class="footer__col footer__col--packages">
          <h3 class="footer__col-title">Paketler</h3>
          <ul class="footer__links">
            @foreach (var p in layout.MenuPackages)
            {
            <li><a href="/paketler#@p.Slug" title="@p.Name">@p.Name</a></li>
            }
          </ul>
        </div>

        <div class="footer__col footer__col--hours">
          <h3 class="footer__col-title">Çalışma saatleri</h3>
          <p class="footer__subtitle">@layout.Settings.WorkingDays1</p>
          <p class="footer__text">@layout.Settings.WorkingHours1</p>
          @if (!string.IsNullOrWhiteSpace(layout.Settings.WorkingDays2))
          {
          <p class="footer__subtitle footer__subtitle--spaced">@layout.Settings.WorkingDays2</p>
          <p class="footer__text">@layout.Settings.WorkingHours2</p>
          }
        </div>

        <div class="footer__col footer__col--contact">
          <h3 class="footer__col-title">Bültene Katıl</h3>

          <form class="footer__form" novalidate>
            <div class="footer__input-group">
              <label for="footer-email" class="footer__visually-hidden">E-posta adresiniz</label>
              <input type="email" id="footer-email" name="email" class="footer__input" placeholder="E-posta adresiniz" required>
              <button type="submit" class="footer__submit" title="Gönder" aria-label="Gönder">
                <iconify-icon icon="bi:send" mode="svg" noobserver width="20" height="20" aria-hidden="true"></iconify-icon>
              </button>
            </div>

            <div class="footer__checkbox-group">
              <input type="checkbox" id="footer-privacy" name="privacy" class="footer__checkbox" required>
              <label for="footer-privacy" class="footer__checkbox-label">
                <a href="/gizlilik-politikasi" class="footer__privacy-link" title="Gizlilik Politikasını görüntüle" target="_blank" rel="noopener">Gizlilik Politikasını</a> ve <a href="/yasal/ticari-ileti" class="footer__privacy-link" title="Ticari Elektronik İleti Onay Metnini görüntüle" target="_blank" rel="noopener">Ticari İleti Onayını</a> kabul ediyorum
              </label>
            </div>
          </form>
        </div>
      </div>
      <!-- Alt satır: kolonların alt boşluğunun içine oturur, footer yüksekliğini değiştirmez (yıl JS ile güncellenir) -->
      <div class="footer__bottom">
        <p class="footer__copyright"><span class="footer__copyright-kelime">Copyright </span>&copy; <span data-yil>2026</span> EmirCoaching</p>
        <a href="https://github.com/ridvancomez" class="footer__credit" title="Rıdvan Çömez GitHub profili" target="_blank" rel="noopener">Created by Rıdvan Çömez</a>
      </div>
    </div>
  </footer>
