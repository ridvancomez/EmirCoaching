@{
    var Nav = new EmirCoaching.Web.Services.NavState(ViewData["ActiveNav"] as string);
}
  <header class="navbar">
    <div class="navbar__inner">
      <a href="/" class="navbar__logo" title="Emir Coaching Anasayfa">
        <img src="/images/logo.png" alt="Emir Coaching Logo" title="Emir Coaching Logo" width="194" height="29"
          class="navbar__logo-img">
      </a>

      <input type="checkbox" id="navbar-toggle" class="navbar__toggle-input">
      <label for="navbar-toggle" class="navbar__toggle" aria-label="Menüyü aç/kapat">
        <span class="navbar__toggle-bar"></span>
        <span class="navbar__toggle-bar"></span>
        <span class="navbar__toggle-bar"></span>
      </label>

      <nav class="navbar__nav" aria-label="Ana menü">
        <ul class="navbar__menu">
          <li class="navbar__menu-item">
            <a href="/" class="navbar__menu-link@(Nav.Active("anasayfa", " navbar__menu-link--active"))" title="Ana Sayfa">Ana Sayfa</a>
          </li>
          <li class="navbar__menu-item navbar__menu-item--dropdown">
            <a href="/paketler" class="navbar__menu-link@(Nav.Active("paketler", " navbar__menu-link--active")) navbar__menu-link--dropdown" title="Paketler sayfasına git" aria-haspopup="true">Paketler
              <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="navbar__chevron" aria-hidden="true"></iconify-icon></a>
            <ul class="navbar__dropdown" aria-label="Paketler">
              <li><a href="/paketler#temel-paket" class="navbar__dropdown-link" title="Başlangıç & Deneme paketine git">Başlangıç &amp; Deneme</a></li>
              <li><a href="/paketler#orta-paket" class="navbar__dropdown-link" title="Dönüşüm Protokolü paketine git">Dönüşüm Protokolü</a></li>
              <li><a href="/paketler#premium-paket" class="navbar__dropdown-link" title="VIP Yaşam Tarzı paketine git">VIP Yaşam Tarzı</a></li>
            </ul>
          </li>
          <li class="navbar__menu-item">
            <a href="/hakkimda" class="navbar__menu-link@(Nav.Active("hakkimda", " navbar__menu-link--active"))" title="Hakkımda sayfasına git">Hakkımda</a>
          </li>
          <li class="navbar__menu-item">
            <a href="/degisimler" class="navbar__menu-link@(Nav.Active("degisimler", " navbar__menu-link--active"))" title="Değişimler sayfasına git">Değişimler</a>
          </li>
          <li class="navbar__menu-item">
            <a href="/iletisim" class="navbar__menu-link@(Nav.Active("iletisim", " navbar__menu-link--active"))" title="İletişim sayfasına git">İletişim</a>
          </li>
          <li class="navbar__menu-item">
            <a href="/blog" class="navbar__menu-link@(Nav.Active("blog", " navbar__menu-link--active"))" title="Blog sayfasına git">Blog</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <div class="mobile-drawer-overlay" aria-hidden="true"></div>

  <aside id="mobile-drawer" class="mobile-drawer" aria-label="Mobil menü" aria-hidden="true">
    <a href="/" class="mobile-drawer__logo" title="Emir Coaching Anasayfa">
      <img src="/images/footer-logo.png" alt="Emir Coaching Logo" title="Emir Coaching Logo" width="194" height="29"
        class="mobile-drawer__logo-img">
    </a>

    <nav class="mobile-drawer__nav" aria-label="Mobil ana menü">
      <ul class="mobile-drawer__menu">
        <li class="mobile-drawer__item">
          <a href="/" class="mobile-drawer__link@(Nav.Active("anasayfa", " mobile-drawer__link--active"))" aria-current="@Nav.Current("anasayfa")" title="Ana Sayfa">Ana Sayfa</a>
        </li>
        <li class="mobile-drawer__item">
          <button type="button" class="mobile-drawer__link@(Nav.Active("paketler", " mobile-drawer__link--active")) mobile-drawer__submenu-toggle" aria-expanded="false"
            aria-controls="mobile-drawer-packages">
            Paketler
            <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="mobile-drawer__chevron"
              aria-hidden="true"></iconify-icon>
          </button>
          <ul id="mobile-drawer-packages" class="mobile-drawer__submenu">
            <li>
              <a href="/paketler#temel-paket" class="mobile-drawer__sublink" title="Başlangıç &amp; Deneme paketine git">Başlangıç &amp; Deneme</a>
            </li>
            <li>
              <a href="/paketler#orta-paket" class="mobile-drawer__sublink" title="Dönüşüm Protokolü paketine git">Dönüşüm Protokolü</a>
            </li>
            <li>
              <a href="/paketler#premium-paket" class="mobile-drawer__sublink" title="VIP Yaşam Tarzı paketine git">VIP Yaşam Tarzı</a>
            </li>
          </ul>
        </li>
        <li class="mobile-drawer__item">
          <a href="/hakkimda" class="mobile-drawer__link@(Nav.Active("hakkimda", " mobile-drawer__link--active"))" aria-current="@Nav.Current("hakkimda")" title="Hakkımda sayfasına git">Hakkımda</a>
        </li>
        <li class="mobile-drawer__item">
          <a href="/degisimler" class="mobile-drawer__link@(Nav.Active("degisimler", " mobile-drawer__link--active"))" aria-current="@Nav.Current("degisimler")" title="Değişimler sayfasına git">Değişimler</a>
        </li>
        <li class="mobile-drawer__item">
          <a href="/blog" class="mobile-drawer__link@(Nav.Active("blog", " mobile-drawer__link--active"))" aria-current="@Nav.Current("blog")" title="Blog sayfasına git">Blog</a>
        </li>
        <li class="mobile-drawer__item">
          <a href="/iletisim" class="mobile-drawer__link@(Nav.Active("iletisim", " mobile-drawer__link--active"))" aria-current="@Nav.Current("iletisim")" title="İletişim sayfasına git">İletişim</a>
        </li>
      </ul>
    </nav>
  </aside>
