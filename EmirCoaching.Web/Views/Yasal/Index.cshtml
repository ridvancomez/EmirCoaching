@model LegalViewModel
@{
    ViewData["Title"] = $"{Model.Title} | Emir Coaching";
    ViewData["Description"] = Model.IsPrivacyPolicy
        ? "Emir Coaching gizlilik politikası: KVKK kapsamında kişisel verilerinizin hangi amaçlarla toplandığı, nasıl işlendiği, ne kadar saklandığı ve veri sahibi olarak haklarınız."
        : $"Emir Coaching {Model.Title}: güncel sürüm, yürürlük tarihi ve revizyon geçmişi.";
}

  <main class="gizlilik">
    <!-- Hero'nun sağındaki dekoratif şekil (PDF: döndürülmüş yuvarlak köşeli kare, #4b4fc7 %10) -->
    <svg class="gizlilik__deco" viewBox="997.3 -422.7 1416.1 1416.1" aria-hidden="true" focusable="false">
      <path d="M1560 -347L1066 176C997 249 1001 363 1073 431L1596 925C1669 993 1783 990 1851 918L2345 394C2413 322 2410 208 2338 140L1814 -354C1742 -423 1628 -419 1560 -347Z" />
    </svg>

    <!-- ==================== Gizlilik Hero ==================== -->
    <section class="gizlilik-hero" aria-labelledby="gizlilik-title">
      <nav class="paketler-hero__breadcrumb gizlilik-hero__breadcrumb" aria-label="Sayfa konumu">
        <ul class="paketler-hero__breadcrumb-list">
          <li class="paketler-hero__breadcrumb-item">
            <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
          </li>
          <li class="paketler-hero__breadcrumb-item">
            <a href="@Model.Url" class="paketler-hero__breadcrumb-link" title="@Model.Title" aria-current="page">@Model.Title</a>
          </li>
        </ul>
      </nav>

      <div class="container gizlilik-hero__inner">
        <h1 id="gizlilik-title" class="gizlilik-hero__title">@Model.Title</h1>
        @if (Model.IsPrivacyPolicy && Model.Lead is not null)
        {
        <p class="gizlilik-hero__lead">
          @Model.Lead
        </p>
        }

        <div class="gizlilik-hero__bar">
          <dl class="gizlilik-meta">
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Versiyon</dt>
              <dd class="gizlilik-meta__value">v@(Model.Document?.Version ?? 0)</dd>
            </div>
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Yürürlük Tarihi</dt>
              <dd class="gizlilik-meta__value"><time datetime="@Model.EffectiveAt.ToString("yyyy-MM-dd")">@SiteFormat.LongDate(Model.EffectiveAt)</time></dd>
            </div>
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Son Güncelleme</dt>
              <dd class="gizlilik-meta__value"><time datetime="@Model.UpdatedAt.ToString("yyyy-MM-dd")">@SiteFormat.LongDate(Model.UpdatedAt)</time></dd>
            </div>
          </dl>
          @if (Model.Document?.FileUrl is { } fileUrl)
          {
          <a href="@fileUrl" class="gizlilik-hero__download" download
            title="@Model.Title PDF olarak indir">
            <iconify-icon icon="mdi:tray-arrow-down" mode="svg" noobserver class="gizlilik-hero__download-icon" aria-hidden="true"></iconify-icon>
            PDF Olarak İndir
          </a>
          }
        </div>
      </div>
    </section>

    <!-- ==================== Gövde: politika metni + sticky sidebar ==================== -->
    <div class="gizlilik-body container">
      <!-- Metin panelde (Yasal Metinler) editörle girilir; başlıklardan içindekiler sunucuda kurulur -->
      <article class="gizlilik-body__content" aria-labelledby="gizlilik-title">
        <div class="yasal-icerik">
          @if (Model.Document is null)
          {
          <p>Bu metin hazırlanıyor. Sorularınız için @Model.LegalEmail adresine yazabilirsiniz.</p>
          }
          else if (!string.IsNullOrEmpty(Model.Content.Html))
          {
          @Html.Raw(Model.Content.Html)
          }
          else if (Model.Document.FileUrl is { } pdf)
          {
          <p>Bu metnin güncel hali PDF olarak yayında: <a href="@pdf" target="_blank" rel="noopener">@Model.Title (PDF)</a></p>
          }
        </div>
        <section class="gizlilik-revizyon" aria-labelledby="revizyon-gecmisi" hidden="@(Model.Revisions.Count == 0)">
          <h2 id="revizyon-gecmisi" class="gizlilik-revizyon__title">Revizyon Geçmişi</h2>
          <ul class="gizlilik-revizyon__list">
            @foreach (var revision in Model.Revisions)
            {
            <li><time datetime="@revision.RevisedAt.ToString("yyyy-MM-dd")">[@SiteFormat.NumericDate(revision.RevisedAt)]</time> v@revision.Version - @revision.Note</li>
            }
          </ul>
        </section>
      </article>

      <aside class="gizlilik-body__sidebar" aria-label="İçindekiler ve ilgili belgeler">
        <nav class="gizlilik-icindekiler" data-toc="gizlilik-icindekiler" data-toc-mobile="999" hidden="@(Model.Content.Entries.Count == 0)"
          aria-labelledby="gizlilik-icindekiler-title">
          <button type="button" class="gizlilik-icindekiler__toggle" aria-expanded="true" aria-controls="gizlilik-icindekiler-list">
            <span id="gizlilik-icindekiler-title">İçindekiler</span>
            <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="gizlilik-icindekiler__chevron" aria-hidden="true"></iconify-icon>
          </button>
          <ol id="gizlilik-icindekiler-list" class="gizlilik-icindekiler__list">
            @for (var i = 0; i < Model.Content.Entries.Count; i++)
            {
                var entry = Model.Content.Entries[i];
            <li>
              <a href="#@entry.Id" class="gizlilik-icindekiler__link" title="@entry.Text bölümüne git">
                <span class="gizlilik-icindekiler__no">@SiteFormat.StepNumber(i)</span> @entry.Text
              </a>
            </li>
            }
          </ol>
        </nav>

        <section class="gizlilik-belgeler" aria-labelledby="ilgili-belgeler">
          <h2 id="ilgili-belgeler" class="gizlilik-belgeler__title">İlgili Belgeler</h2>
          <!-- Her belge aynı sayfada açılır; içerik panelden girilir -->
          <ul class="gizlilik-belgeler__list">
            <li>
              <a href="/yasal/kvkk" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "kvkk" ? "page" : null)" title="KVKK Aydınlatma Metni">
                <iconify-icon icon="mdi:file-document-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">KVKK Aydınlatma Metni</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/acik-riza" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "acik-riza" ? "page" : null)" title="Açık Rıza Metni">
                <iconify-icon icon="mdi:shield-check-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Açık Rıza Metni</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/iptal-iade" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "iptal-iade" ? "page" : null)" title="İptal ve İade Koşulları">
                <iconify-icon icon="mdi:cash-refund" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">İptal ve İade Koşulları</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/ticari-ileti" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "ticari-ileti" ? "page" : null)" title="Ticari Elektronik İleti Onayı">
                <iconify-icon icon="mdi:email-check-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Ticari Elektronik İleti Onayı</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/cerez" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "cerez" ? "page" : null)" title="Çerez Politikası">
                <iconify-icon icon="mdi:cookie-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Çerez Politikası</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/mesafeli-satis" class="gizlilik-belgeler__link" aria-current="@(Model.Slug == "mesafeli-satis" ? "page" : null)" title="Mesafeli Satış Sözleşmesi">
                <iconify-icon icon="mdi:file-sign" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Mesafeli Satış Sözleşmesi</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
          </ul>
        </section>

        <address class="gizlilik-iletisim">
          <iconify-icon icon="mdi:email-outline" mode="svg" noobserver class="gizlilik-iletisim__icon" aria-hidden="true"></iconify-icon>
          <span class="gizlilik-iletisim__body">
            <span class="gizlilik-iletisim__title">Hukuk Departmanı</span>
            <a href="mailto:@Model.LegalEmail" class="gizlilik-iletisim__link" title="Hukuk departmanına e-posta gönder">@Model.LegalEmail</a>
          </span>
        </address>
      </aside>
    </div>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="@(await Api.GetWhatsAppUrlAsync())" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/blog-detay.js"></script>
}
