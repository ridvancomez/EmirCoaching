@{
    ViewData["Title"] = "Gizlilik Politikası | Emir Coaching";
    ViewData["Description"] = "Emir Coaching gizlilik politikası: KVKK kapsamında kişisel verilerinizin hangi amaçlarla toplandığı, nasıl işlendiği, ne kadar saklandığı ve veri sahibi olarak haklarınız.";
}

  <main class="gizlilik">
    <!-- Hero'nun sağındaki dekoratif şekil (PDF: döndürülmüş yuvarlak köşeli kare, #4b4fc7 %10) -->
    <svg class="gizlilik__deco" viewBox="997.3 -422.7 1416.1 1416.1" aria-hidden="true" focusable="false">
      <path d="M1560 -347L1066 176C997 249 1001 363 1073 431L1596 925C1669 993 1783 990 1851 918L2345 394C2413 322 2410 208 2338 140L1814 -354C1742 -423 1628 -419 1560 -347Z" />
    </svg>

    <!-- ==================== Gizlilik Hero ==================== -->
    <section class="gizlilik-hero" aria-labelledby="gizlilik-title">
      <nav class="paketler-hero__breadcrumb gizlilik-hero__breadcrumb" aria-label="Sayfa konumu">
        <ul class="paketler-hero__breadcrumb-list">
          <li class="paketler-hero__breadcrumb-item">
            <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
          </li>
          <li class="paketler-hero__breadcrumb-item">
            <a href="/gizlilik-politikasi" class="paketler-hero__breadcrumb-link" title="Gizlilik Politikası" aria-current="page" data-legal-title>Gizlilik Politikası</a>
          </li>
        </ul>
      </nav>

      <div class="container gizlilik-hero__inner">
        <h1 id="gizlilik-title" class="gizlilik-hero__title" data-legal-title>Gizlilik Politikası</h1>
        <p class="gizlilik-hero__lead" data-legal-lead>
          Bu politika, EMIRCOACHING platformunu kullanan bireylerin kişisel verilerinin toplanması, işlenmesi,
          saklanması ve korunmasına ilişkin temel ilkeleri ve yasal yükümlülükleri düzenler.
        </p>

        <div class="gizlilik-hero__bar">
          <dl class="gizlilik-meta">
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Versiyon</dt>
              <dd class="gizlilik-meta__value" data-legal-version>v2.4.0</dd>
            </div>
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Yürürlük Tarihi</dt>
              <dd class="gizlilik-meta__value" data-legal-effective><time datetime="2024-01-01">01 Ocak 2024</time></dd>
            </div>
            <div class="gizlilik-meta__item">
              <dt class="gizlilik-meta__label">Son Güncelleme</dt>
              <dd class="gizlilik-meta__value" data-legal-updated><time datetime="2024-10-15">15 Ekim 2024</time></dd>
            </div>
          </dl>
          <a href="/images/gizlilik-politikasi.pdf" class="gizlilik-hero__download" data-legal-download download
            title="Gizlilik Politikasını PDF olarak indir">
            <iconify-icon icon="mdi:tray-arrow-down" mode="svg" noobserver class="gizlilik-hero__download-icon" aria-hidden="true"></iconify-icon>
            PDF Olarak İndir
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== Gövde: politika metni + sticky sidebar ==================== -->
    <div class="gizlilik-body container">
      <!-- Metin panelde (Yasal Metinler) editörle girilir; js/yasal-metin.js API'den yükler (?tur=kvkk vb.).
           Aşağıdaki statik metin yalnızca API'ye ulaşılamazsa görünür. -->
      <article class="gizlilik-body__content" aria-labelledby="gizlilik-title" data-legal-content>
        <section class="gizlilik-bolum" aria-labelledby="genel-bilgilendirme">
          <h2 id="genel-bilgilendirme" class="gizlilik-bolum__title">
            <span class="gizlilik-bolum__no">1.</span> Genel Bilgilendirme
          </h2>
          <p>
            EMIRCOACHING ("Şirket", "Biz" veya "Bize"), 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") ve
            ilgili ikincil mevzuat kapsamında Veri Sorumlusu sıfatıyla hareket etmektedir. Bu politika,
            hizmetlerimizi kullanırken sağladığınız bilgilerin nasıl yönetildiğini açıklamaktadır.
          </p>
        </section>

        <section class="gizlilik-bolum" aria-labelledby="veri-sorumlusu">
          <h2 id="veri-sorumlusu" class="gizlilik-bolum__title">
            <span class="gizlilik-bolum__no">2.</span> Veri Sorumlusu Kimliği
          </h2>
          <p>6698 sayılı KVKK uyarınca muhatabınız olan veri sorumlusunun bilgileri aşağıdadır:</p>
          <dl class="gizlilik-liste gizlilik-liste--tanim">
            <div class="gizlilik-liste__item">
              <dt>Unvan:</dt>
              <dd>EMIRCOACHING Performans Teknolojileri A.Ş.</dd>
            </div>
            <div class="gizlilik-liste__item">
              <dt>MERSİS No:</dt>
              <dd>0123456789012345</dd>
            </div>
            <div class="gizlilik-liste__item">
              <dt>Adres:</dt>
              <dd>Levent Mah. Büyükdere Cad. No:199, Şişli / İstanbul</dd>
            </div>
          </dl>
        </section>

        <section class="gizlilik-bolum" aria-labelledby="toplanan-veriler">
          <h2 id="toplanan-veriler" class="gizlilik-bolum__title">
            <span class="gizlilik-bolum__no">3.</span> Toplanan Kişisel Veriler
          </h2>
          <p>
            Platformumuz üzerinden sunduğumuz hizmetlerin doğası gereği aşağıdaki veri kategorilerinde kişisel veri
            işlenmektedir:
          </p>
          <!-- CKEditor çıktısı: düz tablo (<figure class="table"><table>…). İlk satır "başlık satırı"
               (thead), ilk sütun "başlık sütunu" (satır <th>) yapılabilir. Bileşen sınıfları, dar ekrandaki
               kart etiketleri (data-label) ve ARIA rolleri js/blog-detay.js ile otomatik eklenir;
               "Tablo özellikleri" eklentisi (sabit genişlik/renk) kapalı olmalı. -->
          <figure class="table">
            <table>
              <thead>
                <tr>
                  <th>Veri Kategorisi</th>
                  <th>Örnek</th>
                  <th>Amaç</th>
                  <th>Saklama Süresi</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th>Kimlik Verisi</th>
                  <td>Ad, Soyad, TCKN</td>
                  <td>Sözleşme Kurulumu</td>
                  <td>10 Yıl</td>
                </tr>
                <tr>
                  <th>İletişim Verisi</th>
                  <td>E-posta, Telefon</td>
                  <td>Müşteri Desteği</td>
                  <td>10 Yıl</td>
                </tr>
                <tr>
                  <th>Sağlık Verisi (Özel Nitelikli)</th>
                  <td>Boy, Kilo, Geçmiş Sakatlıklar</td>
                  <td>Program Optimizasyonu</td>
                  <td>Üyelik + 2 Yıl</td>
                </tr>
              </tbody>
            </table>
          </figure>
        </section>

        <section class="gizlilik-bolum" aria-labelledby="isleme-amaclari">
          <h2 id="isleme-amaclari" class="gizlilik-bolum__title">
            <span class="gizlilik-bolum__no">4.</span> Verilerin İşlenme Amaçları
          </h2>
          <p>Toplanan kişisel verileriniz aşağıdaki amaçlarla işlenmektedir:</p>
          <ul class="gizlilik-liste">
            <li class="gizlilik-liste__item">Kişiselleştirilmiş antrenman ve beslenme programlarının oluşturulması.</li>
            <li class="gizlilik-liste__item">Kullanıcı deneyiminin iyileştirilmesi ve uygulama hatalarının giderilmesi.</li>
            <li class="gizlilik-liste__item">Yasal yükümlülüklerin yerine getirilmesi (Fatura düzenlenmesi vb.).</li>
          </ul>
        </section>

        <section class="gizlilik-bolum" aria-labelledby="veri-sahibi-haklari">
          <h2 id="veri-sahibi-haklari" class="gizlilik-bolum__title">
            <span class="gizlilik-bolum__no">8.</span> Veri Sahibinin Hakları
          </h2>
          <p>
            KVKK Madde 11 uyarınca, kişisel verileriniz üzerinde belirli haklara sahipsiniz. Bu haklar veri işlemeyi
            öğrenme, düzeltme, silme talep etme haklarını içerir.
          </p>
          <div class="gizlilik-callout" role="note" aria-labelledby="basvuru-hakki">
            <iconify-icon icon="mdi:information-outline" mode="svg" noobserver class="gizlilik-callout__icon" aria-hidden="true"></iconify-icon>
            <div class="gizlilik-callout__body">
              <p id="basvuru-hakki" class="gizlilik-callout__title">Başvuru Hakkı</p>
              <p class="gizlilik-callout__text">
                Taleplerinizi sistemimizde kayıtlı bulunan elektronik posta adresiniz üzerinden
                <a href="mailto:kvkk@@emircoaching.com" class="gizlilik-callout__link" title="kvkk@@emircoaching.com adresine e-posta gönder">kvkk@@emircoaching.com</a>
                adresine iletebilirsiniz. Başvurunuz en geç 30 gün içinde ücretsiz olarak sonuçlandırılacaktır.
              </p>
            </div>
          </div>
        </section>

        <section class="gizlilik-revizyon" aria-labelledby="revizyon-gecmisi">
          <h2 id="revizyon-gecmisi" class="gizlilik-revizyon__title">Revizyon Geçmişi</h2>
          <ul class="gizlilik-revizyon__list">
            <li><time datetime="2024-10-15">[15.10.2024]</time> v2.4.0 - Çerez politikası entegrasyonu güncellendi.</li>
            <li><time datetime="2024-01-01">[01.01.2024]</time> v2.3.0 - Sağlık verileri saklama süreleri revize edildi.</li>
          </ul>
        </section>
      </article>

      <aside class="gizlilik-body__sidebar" aria-label="İçindekiler ve ilgili belgeler">
        <nav class="gizlilik-icindekiler" data-toc="gizlilik-icindekiler" data-toc-mobile="999"
          aria-labelledby="gizlilik-icindekiler-title">
          <button type="button" class="gizlilik-icindekiler__toggle" aria-expanded="true" aria-controls="gizlilik-icindekiler-list">
            <span id="gizlilik-icindekiler-title">İçindekiler</span>
            <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="gizlilik-icindekiler__chevron" aria-hidden="true"></iconify-icon>
          </button>
          <ol id="gizlilik-icindekiler-list" class="gizlilik-icindekiler__list">
            <li>
              <a href="#genel-bilgilendirme" class="gizlilik-icindekiler__link" title="Genel Bilgilendirme bölümüne git">
                <span class="gizlilik-icindekiler__no">01</span> Genel Bilgilendirme
              </a>
            </li>
            <li>
              <a href="#veri-sorumlusu" class="gizlilik-icindekiler__link" title="Veri Sorumlusu Kimliği bölümüne git">
                <span class="gizlilik-icindekiler__no">02</span> Veri Sorumlusu
              </a>
            </li>
            <li>
              <a href="#toplanan-veriler" class="gizlilik-icindekiler__link" title="Toplanan Kişisel Veriler bölümüne git">
                <span class="gizlilik-icindekiler__no">03</span> Toplanan Veriler
              </a>
            </li>
            <li>
              <a href="#isleme-amaclari" class="gizlilik-icindekiler__link" title="Verilerin İşlenme Amaçları bölümüne git">
                <span class="gizlilik-icindekiler__no">04</span> İşlenme Amaçları
              </a>
            </li>
            <li>
              <a href="#veri-sahibi-haklari" class="gizlilik-icindekiler__link" title="Veri Sahibinin Hakları bölümüne git">
                <span class="gizlilik-icindekiler__no">08</span> Veri Sahibinin Hakları
              </a>
            </li>
          </ol>
        </nav>

        <section class="gizlilik-belgeler" aria-labelledby="ilgili-belgeler">
          <h2 id="ilgili-belgeler" class="gizlilik-belgeler__title">İlgili Belgeler</h2>
          <!-- Her belge aynı sayfada açılır; içerik panelden girilir (js/yasal-metin.js) -->
          <ul class="gizlilik-belgeler__list">
            <li>
              <a href="/yasal/kvkk" class="gizlilik-belgeler__link" title="KVKK Aydınlatma Metni">
                <iconify-icon icon="mdi:file-document-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">KVKK Aydınlatma Metni</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/acik-riza" class="gizlilik-belgeler__link" title="Açık Rıza Metni">
                <iconify-icon icon="mdi:shield-check-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Açık Rıza Metni</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/iptal-iade" class="gizlilik-belgeler__link" title="İptal ve İade Koşulları">
                <iconify-icon icon="mdi:cash-refund" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">İptal ve İade Koşulları</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/ticari-ileti" class="gizlilik-belgeler__link" title="Ticari Elektronik İleti Onayı">
                <iconify-icon icon="mdi:email-check-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Ticari Elektronik İleti Onayı</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/cerez" class="gizlilik-belgeler__link" title="Çerez Politikası">
                <iconify-icon icon="mdi:cookie-outline" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Çerez Politikası</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
            <li>
              <a href="/yasal/mesafeli-satis" class="gizlilik-belgeler__link" title="Mesafeli Satış Sözleşmesi">
                <iconify-icon icon="mdi:file-sign" mode="svg" noobserver class="gizlilik-belgeler__icon" aria-hidden="true"></iconify-icon>
                <span class="gizlilik-belgeler__text">Mesafeli Satış Sözleşmesi</span>
                <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="gizlilik-belgeler__arrow" aria-hidden="true"></iconify-icon>
              </a>
            </li>
          </ul>
        </section>

        <address class="gizlilik-iletisim">
          <iconify-icon icon="mdi:email-outline" mode="svg" noobserver class="gizlilik-iletisim__icon" aria-hidden="true"></iconify-icon>
          <span class="gizlilik-iletisim__body">
            <span class="gizlilik-iletisim__title">Hukuk Departmanı</span>
            <a href="mailto:legal@@emircoaching.com" class="gizlilik-iletisim__link" title="Hukuk departmanına e-posta gönder">legal@@emircoaching.com</a>
          </span>
        </address>
      </aside>
    </div>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/blog-detay.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/yasal-metin.js"></script>
}
