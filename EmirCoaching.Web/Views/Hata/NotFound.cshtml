@{
    ViewData["Title"] = "404 — Sayfa Bulunamadı | Emir Coaching";
    ViewData["Description"] = "Aradığın sayfa bulunamadı. Emir Coaching paketlerine, danışan değişimlerine, blog yazılarına veya iletişim sayfasına buradan devam edebilirsin.";
    ViewData["Robots"] = "noindex";
}

  <main>
    <!-- ==================== 404 Hero ==================== -->
    <section class="paketler-hero paketler-hero--compact hata-404" aria-labelledby="hata-404-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="404.html" class="paketler-hero__breadcrumb-link" title="404 Hata" aria-current="page">404 Hata</a>
            </li>
          </ul>
        </nav>

        <!-- Dev "404" (dekoratif): Inter'in "4"ü üst üste binen konturlardan oluşur; text-stroke
             bu iç çizgileri gösterdiği için kontur 4px çizilip harfin içi maskeyle silinir,
             geriye temiz 2px dış kontur kalır. -->
        <svg class="hata-404__rakam" viewBox="4 -140 400 145" aria-hidden="true" focusable="false">
          <defs>
            <mask id="hata-404-rakam-maske" maskUnits="userSpaceOnUse" x="4" y="-140" width="400" height="145">
              <rect x="4" y="-140" width="400" height="145" fill="#fff" />
              <text x="0" y="0" font-size="184.7" fill="#000">404</text>
            </mask>
          </defs>
          <text class="hata-404__rakam-metin" x="0" y="0" font-size="184.7" mask="url(#hata-404-rakam-maske)">404</text>
        </svg>

        <h1 id="hata-404-title" class="hata-404__title">
          Bu Sayfa <span class="hata-404__title-vurgu">Programda Yok</span>
        </h1>
        <p class="hata-404__text">Aradığın sayfa taşınmış veya hiç var olmamış olabilir. Aşağıdan devam edebilirsin.</p>

        <form class="hata-404__arama" role="search" action="#" data-hata-arama>
          <label for="hata-404-arama" class="visually-hidden">Sitede ara</label>
          <iconify-icon icon="mdi:magnify" mode="svg" noobserver class="hata-404__arama-icon" aria-hidden="true"></iconify-icon>
          <input type="search" id="hata-404-arama" name="q" class="hata-404__arama-input" placeholder="Sitede ara..."
            autocomplete="off">
        </form>

        <div class="cta__actions hata-404__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== Hızlı linkler ==================== -->
    <section class="hata-404-linkler container" aria-labelledby="hata-404-linkler-title">
      <h2 id="hata-404-linkler-title" class="hata-404-linkler__title">Bunlara Bakmak İsteyebilirsin</h2>
      <ul class="hata-404-linkler__list">
        <li>
          <a href="/paketler" class="hata-404-linkler__card" title="Paketler sayfasına git">
            <span class="hata-404-linkler__name">Paketler</span>
            <span class="hata-404-linkler__desc">Sana uygun kademeyi seç.</span>
            <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="hata-404-linkler__arrow" aria-hidden="true"></iconify-icon>
          </a>
        </li>
        <li>
          <a href="/degisimler" class="hata-404-linkler__card" title="Değişimler sayfasına git">
            <span class="hata-404-linkler__name">Değişimler</span>
            <span class="hata-404-linkler__desc">Gerçek danışan hikayeleri.</span>
            <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="hata-404-linkler__arrow" aria-hidden="true"></iconify-icon>
          </a>
        </li>
        <li>
          <a href="/blog" class="hata-404-linkler__card" title="Blog sayfasına git">
            <span class="hata-404-linkler__name">Blog</span>
            <span class="hata-404-linkler__desc">Kanıta dayalı yazılar.</span>
            <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="hata-404-linkler__arrow" aria-hidden="true"></iconify-icon>
          </a>
        </li>
        <li>
          <a href="/iletisim" class="hata-404-linkler__card" title="İletişim sayfasına git">
            <span class="hata-404-linkler__name">İletişim</span>
            <span class="hata-404-linkler__desc">Sorularını bize ilet.</span>
            <iconify-icon icon="mdi:arrow-right" mode="svg" noobserver class="hata-404-linkler__arrow" aria-hidden="true"></iconify-icon>
          </a>
        </li>
      </ul>
    </section>
  </main>

@section Scripts {
  <script>
    // Site araması henüz yok: form gönderimi şimdilik engellenir (yer tutucu davranış)
    document.querySelector("[data-hata-arama]").addEventListener("submit", (event) => event.preventDefault());
  </script>
}
