@{
    ViewData["Title"] = "Kişiye Özel Diyet Planı | Emir Coaching — Uzman Diyetisyen Desteği";
    ViewData["Description"] = "Uzman diyetisyen tarafından hazırlanan kişiye özel diyet planı: kalori ve makro hesabı, günlük 5 öğün, haftalık menü güncellemesi ve WhatsApp ile 1-1 destek.";
    ViewData["ActiveNav"] = "paketler";
}

  <main>
    <!-- ==================== Hero (paketler hero'su) ==================== -->
    <section class="paketler-hero" aria-labelledby="diyet-hero-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Kişiye Özel Diyet Planı" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/paketler" class="paketler-hero__breadcrumb-link" title="Paketler">Paketler</a>
            </li>
          </ul>
        </nav>

        <h1 id="diyet-hero-title" class="paketler-hero__title paketler-hero__title--wide">
          UZMANLARLA ÇALIŞMAK <span class="paketler-hero__title-accent">PROFESYONELLİK</span> GEREKTİRİR
        </h1>

        <p class="paketler-hero__text">
          Ya da ona benzer bir şey. Bedenin yoldaşları rahattır, ancak seçkin değildirler. Ve nibh, o alacalı
          olan, onun giriş bölümü, hayattır; böylece bir şey olabilir.
        </p>

        <nav class="paketler-hero__filter" aria-label="Paket kategorileri">
          <div class="paketler-hero__tabs">
            <a href="/paketler" class="paketler-hero__tab" title="Tüm paketleri gör">Tümü</a>
            <a href="/paketler?kategori=evde" class="paketler-hero__tab paketler-hero__tab--evde" title="Evde paketleri gör">Evde</a>
            <a href="/paketler?kategori=salonda" class="paketler-hero__tab paketler-hero__tab--salonda" title="Salonda paketleri gör">Salonda</a>
          </div>
          <span class="paketler-hero__diet-btn paketler-hero__diet-btn--active" aria-current="page">Kişiye Özel Diyet Planı</span>
        </nav>
      </div>
    </section>

    <!-- ==================== Program Detay ==================== -->
    <section class="program-detay container" aria-label="Program detayı">
      <article class="program-detay__card" aria-labelledby="program-icerik-title">
        <div class="program-detay__author">
          <img src="/images/uzman-ceyda.jpg" alt="Uzm. Dr. Ceyda Güler" title="Uzm. Dr. Ceyda Güler" width="76"
            height="76" class="program-detay__avatar">
          <p class="program-detay__author-text">
            <span class="program-detay__author-name">Uzm. Dr. <strong>Ceyda Güler</strong></span>
            <span class="program-detay__author-role">Tarafından Hazırlanır</span>
          </p>
        </div>

        <h2 id="program-icerik-title" class="program-detay__title">Program İçeriği</h2>

        <div class="program-detay__lists">
          <ul class="program-detay__list">
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>Kişiye özel kalori ve makro hesabı</span>
              </li>
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>Gluten, laktoz, alerjen alternatifleri</span>
              </li>
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>İlerleme takibi ve raporlama</span>
              </li>
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>Takviye önerisi (isteğe bağlı)</span>
              </li>
          </ul>
          <ul class="program-detay__list">
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>Günlük 5 öğün planlaması</span>
              </li>
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>Haftalık menü güncellemesi</span>
              </li>
              <li class="program-detay__item">
                <iconify-icon icon="mdi:check-circle-outline" mode="svg" noobserver class="program-detay__check" aria-hidden="true"></iconify-icon>
                <span>WhatsApp ile 1-1 destek</span>
              </li>
          </ul>
        </div>
      </article>

      <!-- Diyet planı ayrı bir ürün değil; tüm koçluk paketlerinin parçası -->
      <aside class="program-ucret" aria-labelledby="program-ucret-label">
        <p id="program-ucret-label" class="program-ucret__label">TÜM PAKETLERE DAHİL</p>
        <p class="program-ucret__price program-ucret__price--text">Ek ücret yok</p>
        <p class="program-ucret__note">Seçtiğin koçluk paketiyle birlikte hazırlanır.</p>
        <hr class="program-ucret__divider">
        <ul class="program-ucret__packages">
          <li><a href="/paketler#temel-paket" class="program-ucret__package" title="Başlangıç &amp; Deneme paketini incele"><span>Başlangıç &amp; Deneme</span><span class="program-ucret__package-time">3 Aylık</span></a></li>
          <li><a href="/paketler#orta-paket" class="program-ucret__package" title="Dönüşüm Protokolü paketini incele"><span>Dönüşüm Protokolü</span><span class="program-ucret__package-time">6 Aylık</span></a></li>
          <li><a href="/paketler#premium-paket" class="program-ucret__package" title="VIP Yaşam Tarzı paketini incele"><span>VIP Yaşam Tarzı</span><span class="program-ucret__package-time">12 Aylık</span></a></li>
        </ul>
        <a href="/paketler" class="program-ucret__button" title="Koçluk paketlerini incele">Paketleri İncele</a>
      </aside>
    </section>

    <!-- ==================== Nasıl Çalışır ==================== -->
    <section class="nasil-calisir" aria-labelledby="nasil-calisir-title">
      <div class="container nasil-calisir__inner">
        <h2 id="nasil-calisir-title" class="nasil-calisir__title">Nasıl Çalışır?</h2>
        <ol class="nasil-calisir__steps">
          <li class="nasil-calisir__step">
            <span class="nasil-calisir__icon" aria-hidden="true">
              <iconify-icon icon="mdi:clipboard-text" mode="svg" noobserver></iconify-icon>
            </span>
            <h3 class="nasil-calisir__step-title">1. Formu Doldur</h3>
            <p class="nasil-calisir__step-text">Paketini aldıktan sonra koçun WhatsApp'tan danışan bilgi formunu gönderir; hedeflerini ve beslenme alışkanlıklarını orada paylaşırsın.</p>
          </li>
          <li class="nasil-calisir__step">
            <span class="nasil-calisir__icon" aria-hidden="true">
              <iconify-icon icon="mdi:silverware-fork-knife" mode="svg" noobserver></iconify-icon>
            </span>
            <h3 class="nasil-calisir__step-title">2. Planın Hazırlanır</h3>
            <p class="nasil-calisir__step-text">Formun ve tahlillerin ulaşınca uzmanımız planını 48 saat içinde hazırlar.</p>
          </li>
          <li class="nasil-calisir__step">
            <span class="nasil-calisir__icon" aria-hidden="true">
              <iconify-icon icon="mdi:message-text" mode="svg" noobserver></iconify-icon>
            </span>
            <h3 class="nasil-calisir__step-title">3. WhatsApp'tan Ulaşılır</h3>
            <p class="nasil-calisir__step-text">Planın sana WhatsApp üzerinden iletilir ve destek sürecimiz başlar.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="cta cta--detail" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>
