@{
    ViewData["Title"] = "Diyet Formu | Emir Coaching — Kişiye Özel Diyet Planı Başvurusu";
    ViewData["Description"] = "Seçtiğin koçluk paketi için kişisel ve iletişim bilgilerini bırak, ödemeni Shopier'de güvenle tamamla; koçun WhatsApp'tan sana ulaşsın.";
    ViewData["ActiveNav"] = "paketler";
}

  <main>
    <!-- ==================== Hero (paketler hero'su) ==================== -->
    <section class="paketler-hero" aria-labelledby="diyet-form-hero-title">
      <img src="/images/paketlerslider.png" alt="Karanlık spor salonunda ağırlık çalışan sporcu"
        title="Emir Coaching Diyet Formu" class="paketler-hero__bg">
      <div class="paketler-hero__overlay" aria-hidden="true"></div>
      <div class="paketler-hero__fade" aria-hidden="true"></div>

      <div class="paketler-hero__content">
        <nav class="paketler-hero__breadcrumb" aria-label="Sayfa konumu">
          <ul class="paketler-hero__breadcrumb-list">
            <li class="paketler-hero__breadcrumb-item">
              <a href="/" class="paketler-hero__breadcrumb-link" title="Ana Sayfa">Ana Sayfa</a>
            </li>
            <li class="paketler-hero__breadcrumb-item">
              <a href="/paketler" class="paketler-hero__breadcrumb-link" title="Paketler">Paketler</a>
            </li>
          </ul>
        </nav>

        <h1 id="diyet-form-hero-title" class="paketler-hero__title paketler-hero__title--wide">
          UZMANLARLA ÇALIŞMAK <span class="paketler-hero__title-accent">PROFESYONELLİK</span> GEREKTİRİR
        </h1>

        <p class="paketler-hero__text">
          Ya da ona benzer bir şey. Bedenin yoldaşları rahattır, ancak seçkin değildirler. Ve nibh, o alacalı
          olan, onun giriş bölümü, hayattır; böylece bir şey olabilir.
        </p>

        <nav class="paketler-hero__filter" aria-label="Paket kategorileri">
          <div class="paketler-hero__tabs">
            <a href="/paketler" class="paketler-hero__tab" title="Tüm paketleri gör">Tümü</a>
            <a href="/paketler?kategori=evde" class="paketler-hero__tab paketler-hero__tab--evde" title="Evde paketleri gör">Evde</a>
            <a href="/paketler?kategori=salonda" class="paketler-hero__tab paketler-hero__tab--salonda" title="Salonda paketleri gör">Salonda</a>
          </div>
          <span class="paketler-hero__diet-btn paketler-hero__diet-btn--active" aria-current="page">Kişiye Özel Diyet Planı</span>
        </nav>
      </div>
    </section>

    <!-- ==================== Diyet Formu ==================== -->
    <section class="diyet-form container" aria-label="Diyet formu">
      <!-- Satın alma akışı: Paket Detay "Satın Al" → bu form (?paket=…&yer=…) → "Bilgilerin alındı" → Shopier.
           JS varken form 2 adımlı sihirbaz olur (js/diyet-formu.js); JS yoksa tüm bölümler alt alta görünür. -->
      <form id="diyet-form" class="diyet-form__form" novalidate>
        <div class="diyet-form__section diyet-form__paket">
          <div class="diyet-form__field">
            <label for="paket" class="diyet-form__label">Seçilen Paket</label>
            <div class="diyet-form__select-wrap">
              <select id="paket" name="paket" class="diyet-form__input diyet-form__select" required>
                <option value="" disabled selected>Paket seçin</option>
                <optgroup label="Salonda">
                  <option value="temel-salonda">Başlangıç &amp; Deneme · 3 Aylık · ₺8.999</option>
                  <option value="orta-salonda">Dönüşüm Protokolü · 6 Aylık · ₺15.999</option>
                  <option value="premium-salonda">VIP Yaşam Tarzı · 12 Aylık · ₺27.999</option>
                </optgroup>
                <optgroup label="Evde">
                  <option value="temel-evde">Başlangıç &amp; Deneme (Evde) · 3 Aylık · ₺5.999</option>
                  <option value="orta-evde">Dönüşüm Protokolü (Evde) · 6 Aylık · ₺10.999</option>
                  <option value="premium-evde">VIP Yaşam Tarzı (Evde) · 12 Aylık · ₺18.999</option>
                </optgroup>
              </select>
              <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="diyet-form__select-icon" aria-hidden="true"></iconify-icon>
            </div>
          </div>
        </div>

        <ol class="diyet-form__steps" aria-label="Form adımları">
          <li class="diyet-form__step"><span class="diyet-form__step-num" aria-hidden="true">1</span><span class="diyet-form__step-name">Kişisel</span></li>
          <li class="diyet-form__step"><span class="diyet-form__step-num" aria-hidden="true">2</span><span class="diyet-form__step-name">İletişim</span></li>
        </ol>

        <fieldset class="diyet-form__section" data-step="1">
          <legend class="diyet-form__legend">
            <span class="diyet-form__badge" aria-hidden="true">1</span>
            <h2 class="diyet-form__title">Kişisel Bilgiler</h2>
          </legend>
          <div class="diyet-form__fields">
            <div class="diyet-form__row">
              <div class="diyet-form__field">
                <label for="ad-soyad" class="diyet-form__label">Ad Soyad</label>
                <input type="text" id="ad-soyad" name="ad-soyad" class="diyet-form__input" placeholder="Örn: Ahmet Yılmaz" autocomplete="name" required>
              </div>
              <div class="diyet-form__row diyet-form__row--tight">
                <div class="diyet-form__field">
                  <label for="cinsiyet" class="diyet-form__label">Cinsiyet</label>
                  <div class="diyet-form__select-wrap">
                    <select id="cinsiyet" name="cinsiyet" class="diyet-form__input diyet-form__select" required>
                      <option value="" disabled selected>Seçin</option>
                      <option value="erkek">Erkek</option>
                      <option value="kadin">Kadın</option>
                    </select>
                    <iconify-icon icon="akar-icons:chevron-down" mode="svg" noobserver class="diyet-form__select-icon" aria-hidden="true"></iconify-icon>
                  </div>
                </div>
                <div class="diyet-form__field">
                  <label for="yas" class="diyet-form__label">Yaş</label>
                  <input type="number" id="yas" name="yas" class="diyet-form__input" placeholder="25" min="10" max="100" inputmode="numeric" required>
                </div>
              </div>
            </div>
            <div class="diyet-form__row">
              <div class="diyet-form__field">
                <label for="boy" class="diyet-form__label">Boy (cm)</label>
                <input type="number" id="boy" name="boy" class="diyet-form__input" placeholder="180" min="100" max="250" inputmode="numeric" required>
              </div>
              <div class="diyet-form__row diyet-form__row--tight">
                <div class="diyet-form__field">
                  <label for="mevcut-kilo" class="diyet-form__label">Mevcut Kilo</label>
                  <input type="number" id="mevcut-kilo" name="mevcut-kilo" class="diyet-form__input" placeholder="85.5" min="30" max="300" step="0.1" inputmode="decimal" required>
                </div>
                <div class="diyet-form__field">
                  <label for="hedef-kilo" class="diyet-form__label">Hedef Kilo</label>
                  <input type="number" id="hedef-kilo" name="hedef-kilo" class="diyet-form__input" placeholder="78.0" min="30" max="300" step="0.1" inputmode="decimal" required>
                </div>
              </div>
            </div>
          </div>
        </fieldset>

        <fieldset class="diyet-form__section" data-step="2">
          <legend class="diyet-form__legend">
            <span class="diyet-form__badge" aria-hidden="true">2</span>
            <h2 class="diyet-form__title">İletişim Bilgileri</h2>
          </legend>
          <div class="diyet-form__fields">
            <div class="diyet-form__row">
              <div class="diyet-form__field">
                <label for="eposta" class="diyet-form__label">E-posta</label>
                <input type="email" id="eposta" name="eposta" class="diyet-form__input" placeholder="Örn: ornek@@eposta.com" autocomplete="email" maxlength="256" required>
              </div>
              <div class="diyet-form__field">
                <label for="telefon" class="diyet-form__label">Telefon Numarası</label>
                <input type="tel" id="telefon" name="telefon" class="diyet-form__input" placeholder="05xx xxx xx xx" autocomplete="tel" inputmode="tel" pattern="\+?[0-9 ()\-]{10,20}" required>
              </div>
            </div>
          </div>
        </fieldset>

        <!-- Onaylar: KVKK aydınlatması ve sağlık verisi açık rızası ayrı kutularda (KVKK md. 6:
             boy, kilo, alerji, takviye özel nitelikli veri; açık rıza başka beyanla birleştirilmez) -->
        <div class="diyet-form__consents">
          <div class="diyet-form__field diyet-form__consent">
            <div class="diyet-form__consent-row">
              <input type="checkbox" id="kvkk-aydinlatma" name="kvkk-aydinlatma" class="diyet-form__checkbox" required>
              <label for="kvkk-aydinlatma" class="diyet-form__consent-label">
                <a href="/yasal/kvkk" class="diyet-form__consent-link"
                  title="KVKK Aydınlatma Metnini görüntüle" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>'ni
                okudum.
              </label>
            </div>
          </div>

          <div class="diyet-form__field diyet-form__consent">
            <div class="diyet-form__consent-row">
              <input type="checkbox" id="saglik-acik-riza" name="saglik-acik-riza" class="diyet-form__checkbox" required>
              <label for="saglik-acik-riza" class="diyet-form__consent-label">
                Sağlık verilerimin (boy, kilo, alerji, takviye bilgileri vb.) kişiye özel diyet planımın hazırlanması
                amacıyla işlenmesine <a href="/yasal/acik-riza" class="diyet-form__consent-link"
                  title="Açık Rıza Metnini görüntüle" target="_blank" rel="noopener">Açık Rıza Metni</a> kapsamında
                açık rıza veriyorum.
              </label>
            </div>
          </div>
        </div>

        <div class="diyet-form__nav">
          <button type="button" class="diyet-form__back" title="Önceki adıma dön" data-step-prev hidden>
            <iconify-icon icon="fa6-solid:chevron-left" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>Geri</span>
          </button>
          <button type="button" class="diyet-form__submit diyet-form__next" title="Sonraki adıma geç" data-step-next hidden>
            <span>İleri</span>
            <iconify-icon icon="fa6-solid:chevron-right" mode="svg" noobserver aria-hidden="true"></iconify-icon>
          </button>
          <button type="submit" class="diyet-form__submit" title="Bilgilerini gönder ve ödeme adımına geç">
            <iconify-icon icon="bi:send" mode="svg" noobserver class="diyet-form__submit-icon" aria-hidden="true"></iconify-icon>
            <span>Gönder ve Ödemeye Geç</span>
          </button>
        </div>
      </form>

      <!-- Form gönderilince: ödeme Shopier'de, yeni sekmede (kullanıcı tıklar; pop-up engeline takılmaz).
           Backend: buton href'ine seçilen paketin Shopier ürün linkini basar. -->
      <div class="diyet-form__done" id="diyet-form-done" tabindex="-1" hidden>
        <span class="diyet-form__done-icon" aria-hidden="true">
          <iconify-icon icon="ph:check-bold" mode="svg" noobserver></iconify-icon>
        </span>
        <h2 class="diyet-form__done-title">Bilgilerin Alındı</h2>
        <p class="diyet-form__done-text">Son adım: <strong class="diyet-form__done-paket">Dönüşüm Protokolü</strong> paketinin ödemesini Shopier'de tamamla.</p>
        <a href="https://www.shopier.com/" class="diyet-form__submit diyet-form__pay" title="Ödemeyi Shopier'de tamamla (yeni sekmede açılır)" target="_blank" rel="noopener">
          <iconify-icon icon="solar:lock-keyhole-minimalistic-bold" mode="svg" noobserver class="diyet-form__submit-icon" aria-hidden="true"></iconify-icon>
          <span>Ödemeyi Shopier'de Tamamla</span>
        </a>
        <p class="diyet-form__done-note">Ödemen tamamlanınca koçun WhatsApp'tan sana ulaşır; danışan bilgi formunu ve tahlil rehberini oradan gönderir.</p>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta__inner">
        <h2 id="cta-title" class="cta__title">HANGİ PAKETİN SANA UYGUN OLDUĞUNDAN EMİN DEĞİL MİSİN?</h2>
        <p class="cta__text">Hedeflerini bizimle paylaş, senin için en doğru başlangıç noktasını birlikte belirleyelim.</p>
        <div class="cta__actions">
          <button type="button" class="hero__button hero__button--primary" title="Paket seçimi için bizimle iletişime geç"
            data-contact-trigger>Hemen Başla</button>
          <a href="https://wa.me/905453712515" class="hero__button hero__button--secondary"
            title="WhatsApp üzerinden bize ulaşın" target="_blank" rel="noopener">
            <iconify-icon icon="fa6-brands:whatsapp" mode="svg" noobserver aria-hidden="true"></iconify-icon>
            <span>WhatsApp İletişim</span>
          </a>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="/js/diyet-formu.js"></script>
}
